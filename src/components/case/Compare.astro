---
import type { Localized } from '../../content/site';
import { withBase } from '../../scripts/url';

interface Props {
  before: string;
  after: string;
  /** What the screens show, for alt text and the slider label. */
  label: Localized;
  /** Numbered marks on the "after" screen, as fractions of it (x, y), matching the changes list. */
  marks?: ([number, number] | undefined)[];
  /** Where the handle starts, % of the phone's width. */
  start?: number;
}

/**
 * Before/after slider inside one iPhone body: the old screen on the left of the handle,
 * the new one on the right. A native range input drives it, so keys and screen readers work.
 */
const { before, after, label, marks = [], start = 50 } = Astro.props;
// A mark's place on the whole body: the screen sits 24/450 in and 23/920 down
const onBody = ([x, y]: [number, number]) => ({
  x: ((24 + 402 * x) / 450) * 100,
  y: ((23 + 874 * y) / 920) * 100,
});
---

<div class="compare" data-compare style={`--pos: ${start}%`}>
  <div class="phone">
    <img
      class="screen"
      src={withBase(after)}
      alt={`${label.ru}: после`}
      data-en-alt={`${label.en}: after`}
      loading="lazy"
      draggable="false"
    />
    <img
      class="screen before"
      src={withBase(before)}
      alt={`${label.ru}: до`}
      data-en-alt={`${label.en}: before`}
      loading="lazy"
      draggable="false"
    />
    <img
      class="body"
      src={withBase('assets/iphone-17-pro.webp')}
      alt=""
      loading="lazy"
      draggable="false"
    />
    {marks.map((m, i) => {
      if (!m) return null;
      const at = onBody(m);
      return (
        <span
          class="mark px-clip"
          style={`left: ${at.x}%; top: ${at.y}%`}
          data-mark={i + 1}
          data-x={at.x}
          aria-hidden="true"
        >
          {i + 1}
        </span>
      );
    })}
    <span class="line" aria-hidden="true"></span>
    <span class="handle px-clip" aria-hidden="true">
      <svg viewBox="0 0 12 12" width="18" height="18" shape-rendering="crispEdges">
        <path
          fill="currentColor"
          d="M3 3h1v1H3zM2 4h1v1H2zM1 5h1v2H1zM2 7h1v1H2zM3 8h1v1H3zM8 3h1v1H8zM9 4h1v1H9zM10 5h1v2h-1zM9 7h1v1H9zM8 8h1v1H8zM2 5h8v2H2z"
        ></path>
      </svg>
    </span>
  </div>
  <input
    class="range"
    type="range"
    min="0"
    max="100"
    value={start}
    aria-label={`${label.ru}: до и после`}
    data-en-label={`${label.en}: before and after`}
    data-compare-range
  />
</div>

<style>
  .compare {
    position: relative;
    width: 100%;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 450 / 920;
    container-type: inline-size;
  }
  .screen {
    position: absolute;
    left: calc(24 / 450 * 100%);
    top: calc(23 / 920 * 100%);
    width: calc(402 / 450 * 100%);
    height: calc(874 / 920 * 100%);
    border-radius: calc(60 / 450 * 100cqi);
    object-fit: cover;
    object-position: top;
    background: #0e1116;
  }
  /* The handle sits at --pos of the whole body; the screen starts 24/450 in */
  .before {
    clip-path: inset(0 calc(100% - (var(--pos) * 450 / 402 - 24 / 402 * 100%)) 0 0);
  }
  .body {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .handle {
    --px-step: 3px;
    position: absolute;
    left: var(--pos);
    top: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    transform: translate(-50%, -50%);
    background: var(--surface-card);
    color: var(--text-primary);
    pointer-events: none;
  }
  .line {
    position: absolute;
    left: var(--pos);
    top: calc(23 / 920 * 100%);
    bottom: calc(23 / 920 * 100%);
    width: 2px;
    transform: translateX(-50%);
    background: var(--surface-card);
    pointer-events: none;
  }
  /* The input stays for keys and screen readers, invisible over the phone; pointers are
     handled by initCompare, so a finger drags from anywhere, not only from the thumb */
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }
  /* Marks stay hidden so they don't cover the screen: one shows while its item in the list or
     its spot on the screen is under the pointer (initMarks in case.ts). They belong to the new
     screen, so one under the "before" side stays hidden (initCompare) */
  .mark {
    --px-step: 2px;
    position: absolute;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%) scale(0.6);
    background: var(--sky-400);
    color: var(--ink-1);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }
  .mark.is-lit:not(.is-under) {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
  .compare:has(.range:focus-visible) .handle {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
</style>
