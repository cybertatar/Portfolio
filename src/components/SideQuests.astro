---
import { en, ru, sideQuests, ui } from '../content/site';
import Button from './ui/Button.astro';
import IconButton from './ui/IconButton.astro';
import PixelIcon from './ui/PixelIcon.astro';
import { withBase } from '../scripts/url';

/**
 * Small side projects above the cases, like pinned repos on GitHub. No heading: their small
 * size keeps the cases the main line. The row simply scrolls away; the sticky case stack
 * below starts as before.
 */
---

<section class="side" aria-label={ui.sideQuests.ru} data-en-label={ui.sideQuests.en}>
  <ul class="row">
    {sideQuests.map((q) => {
      const name = { ru: ru(q.title), en: en(q.title) ?? ru(q.title) };
      const label = (what: { ru: string; en: string }) => ({
        label: `${what.ru}: ${name.ru}`,
        'data-en-label': `${what.en}: ${name.en}`,
        'data-en-title': `${what.en}: ${name.en}`,
      });
      return (
        <li class="quest px-clip">
          <div class="head">
            <img class="icon" src={withBase(q.icon)} alt="" width="48" height="48" loading="lazy" />
            <div class="text">
              <h2 class="title" data-en={en(q.title)}>
                {name.ru}
              </h2>
              <p class="description" data-en={q.description.en}>
                {q.description.ru}
              </p>
            </div>
          </div>
          <div class="links">
            {/* The project itself comes first, when there is one to open */}
            {q.app && (
              <Button
                href={q.app}
                target="_blank"
                rel="noopener"
                aria-label={`${ui.bot.ru}: ${name.ru}`}
                data-en-label={`${ui.bot.en}: ${name.en}`}
              >
                <PixelIcon name="telegram" />
                <span data-en={ui.bot.en}>{ui.bot.ru}</span>
              </Button>
            )}
            <IconButton href={q.github} target="_blank" rel="noopener" {...label(ui.repo)}>
              <PixelIcon name="github" />
            </IconButton>
            <IconButton href={q.instagram} target="_blank" rel="noopener" {...label(ui.post)}>
              <PixelIcon name="instagram" />
            </IconButton>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .side {
    margin-bottom: var(--layout-feed-gap);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--layout-feed-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quest {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    background: var(--surface-card);
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }
  .icon {
    display: block;
    flex: none;
    width: 48px;
    height: 48px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-size: var(--t-button);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  .description {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .links {
    display: flex;
    gap: 8px;
  }

  /* Narrow feed: one swipeable row, the next card peeks in */
  @media (max-width: 1200px) {
    .row {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .row::-webkit-scrollbar {
      display: none;
    }
    .quest {
      flex: 0 0 min(82%, max(260px, 44%));
      scroll-snap-align: start;
    }
  }
  @media (max-width: 960px) {
    .side {
      margin-bottom: 16px;
    }
    .row {
      gap: 16px;
      /* Swipe to the screen edge, cards still line up with the 16px frame */
      margin: 0 -16px;
      padding: 0 16px;
      scroll-padding: 0 16px;
    }
  }
</style>
