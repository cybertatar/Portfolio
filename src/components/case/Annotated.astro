---
import { en, ru, type Localized } from '../../content/site';
import { withBase } from '../../scripts/url';
import type { ChangeRow } from './Changes.astro';

/** A spot on the screen as fractions of it (x, y); an optional third number is the height the
 *  leader runs in at before it turns to the spot, when going straight across would cross
 *  something on the way. */
type Spot = [number, number] | [number, number, number];

export interface MarkedRow extends ChangeRow {
  /** Where the change sits on the new screen, as fractions of it (x, y). */
  now: Spot;
  /** More places on the new screen for the same change: its leader forks to each. */
  also?: Spot[];
  /** Where it sat on the old screen; none when the old screen didn't have it on view. */
  was?: Spot;
  /** Said instead of "Стало: …" in the old state when there's nothing to point at. */
  wasNote?: Localized;
  /** On a narrow stage, with no leaders: where the number sits on the new screen, one per
   *  spot (at a corner of the thing or just past its end, so it covers nothing). */
  pins: [number, number][];
  /** The same on the old screen. */
  wasPin?: [number, number];
  /** The callout's side of the phone; its place down that side follows the "now" mark. */
  side: 'left' | 'right';
}

interface Props {
  before: string;
  after: string;
  /** What the screens show, for alt text. */
  label: Localized;
  rows: MarkedRow[];
}

/**
 * The home screen with its changes called out on both sides, and a "Стало / Было" switch in
 * place of a before/after slider (callouts on both sides fought the slider: half of them pointed
 * at the screen under the handle). Each callout keeps its place, only its text and its leader
 * change, so the eye follows a line to where the thing used to be. Numbers run down the left
 * side, then the right. On a narrow stage the callouts go under the phone as a numbered list;
 * small numbers stay on the screen. Leaders are drawn by initAnnotated in case.ts.
 */
const { before, after, label, rows } = Astro.props;
// A mark's place on the whole body: the screen sits 24/450 in and 23/920 down
const onBody = ([x, y]: Spot | [number, number]) =>
  `--x: ${((24 + 402 * x) / 450) * 100}%; top: ${((23 + 874 * y) / 920) * 100}%`;
const sides = (['left', 'right'] as const).map((side) =>
  rows.map((r, i) => ({ ...r, n: i + 1 })).filter((r) => r.side === side),
);
---

<div class="ann" data-ann data-state="now">
  <div class="seg px-clip" role="group" aria-label="Экран" data-en-label="Screen">
    <button type="button" aria-pressed="false" data-ann-to="was" data-en="Before">
      Было
    </button>
    <button type="button" aria-pressed="true" data-ann-to="now" data-en="After">
      Стало
    </button>
  </div>

  <div class="field" data-ann-field>
    <svg class="leaders" aria-hidden="true" data-ann-leaders></svg>
    {sides.map((items, s) => (
      <ol class:list={['side', s ? 'right' : 'left']} start={items[0]?.n}>
        {items.map((r) => (
          <li
            class:list={['callout', { 'off-was': !r.was }]}
            data-ann-item={r.n}
            data-now-y={r.now[1]}
          >
            <span class="head">
              <span class="num" aria-hidden="true">
                {r.n}
              </span>
              <span data-en={en(r.label)}>{ru(r.label)}</span>
            </span>
            {/* Both states in one cell: the callout is as tall as its longer text and doesn't jump */}
            <span class="texts">
              <span class="text now">
                <span class="main" data-en={r.after.en}>
                  {r.after.ru}
                </span>
                <span class="sub" data-en={`Before: ${r.before.en}`}>
                  Было: {r.before.ru}
                </span>
              </span>
              <span class="text was">
                <span class="main" data-en={r.before.en}>
                  {r.before.ru}
                </span>
                {r.was || !r.wasNote ? (
                  <span class="sub" data-en={`After: ${r.after.en}`}>
                    Стало: {r.after.ru}
                  </span>
                ) : (
                  <span class="sub" data-en={r.wasNote.en}>
                    {r.wasNote.ru}
                  </span>
                )}
              </span>
            </span>
          </li>
        ))}
      </ol>
    ))}

    <div class="phone" data-ann-phone>
      <img
        class="screen now"
        src={withBase(after)}
        alt={`${label.ru}: стало`}
        data-en-alt={`${label.en}: after`}
        loading="lazy"
        draggable="false"
      />
      <img
        class="screen was"
        src={withBase(before)}
        alt={`${label.ru}: было`}
        data-en-alt={`${label.en}: before`}
        loading="lazy"
        draggable="false"
      />
      <img
        class="body"
        src={withBase('assets/iphone-17-pro.webp')}
        alt=""
        loading="lazy"
        draggable="false"
      />
      {rows.map((r, i) => (
        <>
          {/* Where the leaders end; never seen */}
          {[r.now, ...(r.also ?? [])].map((at) => (
            <span
              class="spot now"
              style={onBody(at)}
              data-ann-ring={i + 1}
              data-lane={at[2]}
              aria-hidden="true"
            />
          ))}
          {r.was && (
            <span
              class="spot was"
              style={onBody(r.was)}
              data-ann-ring={i + 1}
              data-lane={r.was[2]}
              aria-hidden="true"
            />
          )}
          {/* Narrow stage, no leaders: a small number on the thing itself */}
          {r.pins.map((at) => (
            <span class="pin now" style={onBody(at)} aria-hidden="true">
              <span>{i + 1}</span>
            </span>
          ))}
          {r.wasPin && (
            <span class="pin was" style={onBody(r.wasPin)} aria-hidden="true">
              <span>{i + 1}</span>
            </span>
          )}
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .ann {
    container: ann / inline-size;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* The switch: two pixel tabs on a sunken track, the current one raised like a card */
  .seg {
    --px-step: 2px;
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--surface-active);
  }
  .seg button {
    --px-step: 2px;
    padding: 6px 16px;
    border: 0;
    background: none;
    clip-path: var(--px-clip);
    font: inherit;
    font-size: var(--t-small);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .seg button:hover {
    color: var(--text-primary);
  }
  .seg button[aria-pressed='true'] {
    background: var(--surface-card);
    color: var(--text-primary);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  /* Wide: callouts | phone | callouts. The gaps are where the leaders run */
  .field {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(240px, 34cqi, 340px) minmax(0, 1fr);
    grid-template-areas: 'left phone right';
    column-gap: clamp(40px, 6cqi, 72px);
    width: 100%;
  }
  .phone {
    grid-area: phone;
    position: relative;
    aspect-ratio: 450 / 920;
    container-type: inline-size;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .side {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .side.left {
    grid-area: left;
    text-align: right;
  }
  .side.right {
    grid-area: right;
  }
  /* Without the script the callouts just stack; initAnnotated sets each one's top so its
     number sits level with its mark */
  .ann[data-laid] .callout {
    position: absolute;
    inset-inline: 0;
  }
  .callout {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-small);
    line-height: 1.3;
    color: var(--text-tertiary);
  }
  .left .head {
    flex-direction: row-reverse;
  }
  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    color: var(--text-accent);
    font-size: var(--t-small);
    font-weight: var(--fw-semibold);
    transition:
      background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .callout.is-lit .num {
    background: var(--text-accent);
    color: var(--text-inverse);
  }
  .callout.is-lit .head {
    color: var(--text-primary);
  }
  .texts {
    display: grid;
  }
  .text {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition:
      opacity var(--dur-slow) var(--ease-standard),
      visibility var(--dur-slow);
  }
  .main {
    font-size: var(--t-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  .sub {
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
  }
  /* Nothing on the old screen to point at: the callout steps back */
  .callout.off-was {
    transition: opacity var(--dur-slow) var(--ease-standard);
  }
  .ann[data-state='was'] .callout.off-was {
    opacity: 0.55;
  }
  .ann[data-state='was'] .callout.off-was .num {
    color: var(--text-tertiary);
  }

  /* Screens, rings and leaders of one state at a time */
  .screen {
    position: absolute;
    left: calc(24 / 450 * 100%);
    top: calc(23 / 920 * 100%);
    width: calc(402 / 450 * 100%);
    height: calc(874 / 920 * 100%);
    border-radius: calc(60 / 450 * 100cqi);
    object-fit: cover;
    object-position: top;
    background: #0e1116;
    transition: opacity var(--dur-slow) var(--ease-standard);
  }
  .body {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .spot,
  .pin {
    position: absolute;
    left: var(--x);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .spot {
    width: 1px;
    height: 1px;
  }
  .pin {
    display: none;
  }
  /* Over the phone: the last stretch of each leader runs across the screen to its mark */
  .leaders {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .leaders :global(path),
  .leaders :global(circle) {
    transition:
      opacity var(--dur-slow) var(--ease-standard),
      stroke var(--dur-fast) var(--ease-standard),
      fill var(--dur-fast) var(--ease-standard);
  }
  .leaders :global(path) {
    fill: none;
    stroke-width: 1.25;
    stroke-dasharray: 4 3;
  }
  .leaders :global(.out) {
    stroke: var(--line-3);
  }
  /* On the screen the dashes turn blue: light on the dark new screen, deep on the light old one */
  .leaders :global(.now .in) {
    stroke: var(--sky-300);
  }
  .leaders :global(.was .in) {
    stroke: var(--sky-500);
  }
  .leaders :global(.dot) {
    fill: var(--sky-300);
    stroke: #0e1116;
    stroke-width: 1;
  }
  .leaders :global(.was .dot) {
    fill: var(--sky-500);
    stroke: #fff;
  }
  .leaders :global(.is-lit path) {
    stroke-dasharray: none;
  }
  .leaders :global(.is-lit .out) {
    stroke: var(--sky-500);
  }
  .ann[data-state='now'] .was,
  .ann[data-state='was'] .now,
  .ann[data-state='now'] .leaders :global(g.was),
  .ann[data-state='was'] .leaders :global(g.now) {
    opacity: 0;
    visibility: hidden;
  }
  /* Narrow: the phone, then the callouts as a list under it; no leaders, the numbers match */
  @container ann (max-width: 760px) {
    .field {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'phone' 'left' 'right';
      row-gap: 0;
    }
    .phone {
      justify-self: center;
      width: min(300px, 72cqi);
      margin-bottom: 32px;
    }
    .side.left {
      text-align: left;
    }
    .left .head {
      flex-direction: row;
    }
    .leaders {
      display: none;
    }
    /* No leaders here: a small number on the thing itself, a round translucent glass badge,
       no outline (owner: bright dots were too loud, and the site uses no outlines) */
    .pin {
      display: grid;
      place-items: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      color: rgba(255, 255, 255, 0.9);
      font-size: 11px;
      font-weight: var(--fw-semibold);
      line-height: 1;
      font-variant-numeric: tabular-nums;
      transition: opacity var(--dur-slow) var(--ease-standard);
    }
    /* The figure itself is centred, not its line: trimmed to the cap height and the
       baseline, the box is exactly the digit, whatever the browser makes of the font's
       ascent and descent */
    .pin > span {
      display: block;
      text-box: trim-both cap alphabetic;
    }
    /* Older browsers: Golos sets its figures a little low on a line-height of 1 */
    @supports not (text-box: trim-both cap alphabetic) {
      .pin {
        padding-bottom: 1.5px;
      }
    }
    .pin.was {
      background: rgba(14, 17, 22, 0.1);
      color: rgba(14, 17, 22, 0.7);
    }
    /* The list is under the phone, so a change in its height moves nothing above; reserving
       the longer text made the gaps uneven */
    .ann[data-state='now'] .text.was,
    .ann[data-state='was'] .text.now {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .text,
    .screen,
    .pin,
    .callout.off-was,
    .leaders :global(path) {
      transition: none;
    }
  }
</style>
