---
import { mascotPalette, mascotSprites, type MascotSpriteName } from '../../../content/mascots';

interface Props {
  name: MascotSpriteName;
  class?: string;
}

/** One pixel sprite from src/content/mascots.ts as an SVG that fills its box's width. */
const { name, class: className } = Astro.props;
const rows: readonly string[] = mascotSprites[name];
const w = rows[0].length;
const h = rows.length;

// One rect per horizontal run of the same character
const runs: { x: number; y: number; w: number; c: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    let end = x + 1;
    while (end < row.length && row[end] === c) end++;
    if (c !== '.') runs.push({ x, y, w: end - x, c });
    x = end;
  }
});
---

<svg
  class:list={['sprite', className]}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {runs.map((r) => (
    <rect x={r.x} y={r.y} width={r.w} height="1" fill={mascotPalette[r.c]} />
  ))}
</svg>

<style>
  .sprite {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
