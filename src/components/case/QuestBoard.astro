---
import PixelIcon from '../ui/PixelIcon.astro';
import Sprite from './scenes/Sprite.astro';
import type { MascotSpriteName } from '../../content/mascots';

/**
 * Problems and their solutions, as a guild quest board: four completed quests, all in view, laid
 * out on the sheet itself (no fills). Each quest is a muted problem line and, after a pixel
 * arrow, the solution; numbers stay in the results HUD. Each title links to its full write-up.
 */
export interface Quest {
  /** Section id of the full write-up further down the page */
  id: string;
  title: string;
  sprite: MascotSpriteName;
  problem: string;
  solution: string;
}

interface Props {
  quests: Quest[];
}

const { quests } = Astro.props;
---

<ul class="board">
  {quests.map((q) => (
    <li class="quest">
      <a class="title" href={`#${q.id}`}>
        <span class="sprite" aria-hidden="true">
          <Sprite name={q.sprite} />
        </span>
        {q.title}
      </a>
      <p class="problem">{q.problem}</p>
      <p class="solution">
        <span class="arrow" aria-label="Решение:">
          <PixelIcon name="arrow" size={24} />
        </span>
        {q.solution}
      </p>
    </li>
  ))}
</ul>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px var(--space-split);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 640px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  .quest {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* A quiet line, so the block's own heading stays the only heading */
  .title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
    text-decoration: none;
  }
  .title:hover {
    color: var(--text-accent);
  }
  .sprite {
    display: block;
    flex: none;
    width: 20px;
  }
  .sprite :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .problem,
  .solution {
    margin: 0;
    font-size: var(--t-body);
    line-height: var(--lh-normal);
  }
  .problem {
    color: var(--text-tertiary);
  }
  /* Problem, then the arrow and the solution: the pair reads as one move */
  .solution {
    display: flex;
    gap: 6px;
    color: var(--text-primary);
  }
  .arrow {
    flex: none;
    height: calc(var(--t-body) * var(--lh-normal));
    display: flex;
    align-items: center;
    color: var(--accent);
  }
  .arrow :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
