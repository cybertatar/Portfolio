---
export interface VersusRow {
  label: string;
  before: string;
  after: string;
}
export interface VersusStat {
  value: string;
  unit?: string;
  note: string;
}

interface Props {
  rows: VersusRow[];
  stats: VersusStat[];
}

/**
 * "Before / after" as facts, row by row, under the two lanes of the race above: what it was on
 * the left, what it is on the right, the subject between them. Then the result in a few numbers.
 * On phones each row stacks: the subject, then "было" and "стало" side by side.
 */
const { rows, stats } = Astro.props;
---

<div class="versus">
  <div class="table" role="table" aria-label="Было и стало">
    <div class="row head" role="row">
      <span class="before" role="columnheader">
        Было
      </span>
      <span class="label" role="columnheader">
        <span class="sr">Что</span>
      </span>
      <span class="after" role="columnheader">
        Стало
      </span>
    </div>
    {rows.map((r) => (
      <div class="row" role="row">
        <span class="before" role="cell">
          {r.before}
        </span>
        <span class="label" role="rowheader">
          {r.label}
        </span>
        <span class="after" role="cell">
          {r.after}
        </span>
      </div>
    ))}
  </div>
  <div class="stats" style={`--n: ${stats.length}`}>
    {stats.map((s) => (
      <div class="stat">
        <p class="value">
          {s.value}
          {s.unit && <span class="unit">{s.unit}</span>}
        </p>
        <p class="note">{s.note}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .versus {
    display: flex;
    flex-direction: column;
    gap: 40px;
    container-type: inline-size;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(120px, 18%, 180px) minmax(0, 1fr);
    column-gap: 32px;
    align-items: baseline;
    padding: 14px 0;
    border-top: var(--border-width-keyline) solid var(--border-default);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    text-wrap: pretty;
  }
  /* Closer to its column than the rows are to each other (8 + 14 < 14 + 14) */
  .row.head {
    padding: 0 0 8px;
    border-top: 0;
  }
  .before {
    text-align: right;
    color: var(--text-secondary);
  }
  .after {
    font-weight: var(--fw-medium);
    color: var(--text-primary);
  }
  .label {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    text-align: center;
    color: var(--text-primary);
  }
  .head .before,
  .head .after {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
  }
  .head .before {
    color: var(--text-tertiary);
  }
  .head .after {
    color: var(--sky-600);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* The result: a few numbers, built like the results HUD */
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 40px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .value {
    margin: 0;
    font-size: var(--t-stat);
    font-weight: var(--fw-semibold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .unit {
    margin-left: 0.25em;
    font-size: 0.5em;
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  .note {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }

  /* Narrow sheet: the subject on top, "было" and "стало" side by side under it */
  @container (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 16px;
      row-gap: 6px;
    }
    .label {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: left;
    }
    .before {
      text-align: left;
    }
    .head .label {
      display: none;
    }
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 24px;
    }
  }
</style>
