---
interface Props {
  href: string;
  full?: boolean;
}
const { href, full = false } = Astro.props;
---

<a href={href} class:list={['button', 'px-clip', { full }]}>
  <slot />
</a>

<style>
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    min-width: 0;
    height: var(--control-h);
    padding: 0 20px;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border: 0;
    /* Bevel: shaded bottom edge, like a game button */
    box-shadow: inset 0 -4px 0 var(--bevel-shade-inverse);
    font-family: var(--font-pixel);
    font-size: calc(var(--t-button) * 1.3);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .button:hover {
    background: var(--surface-inverse-hover);
    color: var(--text-inverse);
  }
  .button:active {
    box-shadow: inset 0 4px 0 var(--bevel-shade-inverse);
  }
  .full {
    flex: 1 1 auto;
  }
</style>
