---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Button from '../components/ui/Button.astro';
import Chip from '../components/ui/Chip.astro';
import ContactRow from '../components/ui/ContactRow.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import IconButton from '../components/ui/IconButton.astro';
import Media from '../components/ui/Media.astro';
import { cases, profile, ui } from '../content/site';
import { withBase } from '../scripts/url';
---

<BaseLayout title={`${profile.name.ru} — ${profile.role}`} description={profile.bio.ru}>
  <div class="root">
    <aside class="aside" data-stage="0" data-profile>
      <div class="head">
        <div class="portrait">
          <div class="portrait-media">
            <Media src={profile.portrait} label={ui.portrait} />
          </div>
          <span class="lvl">{profile.level}</span>
        </div>
        <div class="name">
          <h1 data-en={profile.name.en}>{profile.name.ru}</h1>
          <p class="role">{profile.role}</p>
        </div>
      </div>

      <div class="bio">
        <p data-en={profile.bio.en}>{profile.bio.ru}</p>
      </div>

      <div class="zone zone-skills">
        <Eyebrow data-en={ui.skills.en}>{ui.skills.ru}</Eyebrow>
        <div class="chips">
          {profile.skills.map((skill) => (
            <Chip>{skill}</Chip>
          ))}
        </div>
      </div>

      <div class="zone zone-contacts">
        {profile.contacts.map((c, i) => (
          <ContactRow
            href={c.href}
            value={c.value}
            label={c.label}
            external={c.external}
            divider={i < profile.contacts.length - 1}
          />
        ))}
      </div>

      <div class="cta">
        <Button href={profile.cvHref} full>
          CV
        </Button>
        <IconButton href={profile.telegramHref} label="Telegram" target="_blank" rel="noopener">
          <img src={withBase('assets/telegram.png')} alt="" class="telegram" />
        </IconButton>
      </div>
    </aside>

    <main class="feed" data-feed>
      <div class="inner">
        <div class="list">
          {cases.map((item, i) => (
            <article class:list={['slot', { last: i === cases.length - 1 }]} data-slot>
              <ProjectCard item={item} />
            </article>
          ))}
        </div>

        <footer class="footer">
          <Eyebrow tone="secondary" data-en={ui.footer.en}>
            {ui.footer.ru}
          </Eyebrow>
        </footer>
        <div class="spacer" aria-hidden="true" data-spacer></div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { initCardStack, initProfileFit } from '../scripts/home';

  const aside = document.querySelector<HTMLElement>('[data-profile]');
  const feed = document.querySelector<HTMLElement>('[data-feed]');
  if (aside) initProfileFit(aside);
  if (feed) {
    initCardStack(
      feed,
      [...document.querySelectorAll<HTMLElement>('[data-slot]')],
      document.querySelector<HTMLElement>('[data-spacer]'),
    );
  }
</script>

<style>
  .root {
    display: flex;
    align-items: flex-start;
    height: 100vh;
    overflow: hidden;
    background: var(--surface-page);
  }

  /* ---------- Profile aside ---------- */

  .aside {
    flex: 0 0 25%;
    min-width: var(--layout-sidebar-min);
    max-width: var(--layout-sidebar-max);
    align-self: flex-start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    overflow-x: hidden;
    margin: 24px 0 24px 24px;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 1.2vw, 28px);
    background: var(--surface-card);
    border-radius: var(--r-shell);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: none;
    min-width: 0;
  }
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    flex: none;
    border-radius: 8px;
  }
  .portrait-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    color: var(--text-tertiary);
  }
  .lvl {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    height: clamp(26px, 1.6vw, 32px);
    padding: 0 10px;
    background: var(--surface-glass);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 0.62vw, 15px);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-on-glass);
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
    margin-top: clamp(16px, 1vw, 20px);
  }
  h1 {
    margin: 0;
    font-size: var(--t-name);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--text-primary);
  }
  .role {
    margin: 0;
    font-size: var(--t-button);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
  }
  .bio {
    flex: none;
    margin-top: var(--space-zone);
  }
  .bio p {
    margin: 0;
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .zone {
    display: flex;
    flex-direction: column;
    flex: none;
    padding-top: var(--space-zone);
  }
  .zone-skills {
    gap: 12px;
  }
  .zone-contacts {
    gap: 2px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    margin-top: clamp(24px, 1.8vw, 32px);
  }
  .telegram {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  /* Height fit, stage 1+: tighter rhythm */
  .aside:not([data-stage='0']) .bio {
    margin-top: 24px;
  }
  .aside:not([data-stage='0']) .zone {
    padding-top: 24px;
  }
  .aside:not([data-stage='0']) .cta {
    margin-top: 16px;
  }

  /* Stage 2+: compact header in a row with a round 70px portrait */
  .aside:is([data-stage='2'], [data-stage='3']) .head {
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .portrait {
    width: 70px;
    height: 70px;
    aspect-ratio: auto;
    flex: 0 0 70px;
    border-radius: 50%;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .lvl {
    left: auto;
    right: -8px;
    bottom: -4px;
    height: 22px;
    padding: 0 7px;
    border-radius: var(--r-pill);
    background: var(--surface-raised);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: var(--text-primary);
    font-size: 11px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .name {
    margin-top: 0;
  }
  .aside:is([data-stage='2'], [data-stage='3']) h1 {
    font-size: 22px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .role {
    font-size: 14px;
  }

  /* Stage 3: drop the bio */
  .aside[data-stage='3'] .bio {
    display: none;
  }

  /* ---------- Feed ---------- */

  .feed {
    flex: 1 1 auto;
    min-width: 0;
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .inner {
    width: 100%;
    max-width: var(--layout-feed-max);
    margin: 0 auto;
    padding: 24px 40px 0;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--layout-feed-gap);
  }
  .slot {
    position: sticky;
    top: 24px;
    will-change: transform;
  }
  .last {
    height: 86vh;
    min-height: 600px;
  }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 96px;
    border-top: var(--border-width-hair) solid var(--border-subtle);
    margin-top: 48px;
  }
  .spacer {
    height: 0;
  }

  /* ---------- Mobile / tablet portrait ---------- */

  @media (max-width: 960px) {
    .root {
      display: block;
      height: auto;
      overflow-x: clip;
      overflow-y: visible;
    }
    .aside {
      width: calc(100% - 32px);
      max-width: 640px;
      min-width: 0;
      max-height: none;
      overflow: visible;
      margin: 16px auto 0;
    }
    .feed {
      height: auto;
      overflow: visible;
    }
    .inner {
      max-width: 672px;
      padding: 16px 16px 0;
    }
    .list {
      gap: 16px;
    }
    .slot {
      top: 16px;
    }
    .last {
      height: auto;
      min-height: 0;
    }
  }
</style>
