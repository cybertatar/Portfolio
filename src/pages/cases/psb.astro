                <p class="body">{n.text}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <Footer />
    </main>
  </div>
</BaseLayout>

<script>
  import { initCaseMenu, initCompare, initScrollSpy } from '../../scripts/case';

  initScrollSpy(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')],
    document.querySelector<HTMLElement>('[data-case-current]'),
