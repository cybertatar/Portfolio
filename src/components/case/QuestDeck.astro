---
import type { Localized } from '../../content/site';
import PixelIcon from '../ui/PixelIcon.astro';

/**
 * Problems and their solutions as a deck of quest cards that rhymes with the results HUD below:
 * the same cards in the same 2×2 grid, a small label on top and the big value at the bottom.
 * Here the label is the quest, then the muted problem, a quiet pixel arrow down and the
 * solution as the value. Kept calm on purpose: no sprites, no motion, one weight of emphasis, so
 * the HUD below is the only lively block. On phones the deck swipes one card at a time with
 * dots below (initQuestDeck in scripts/case.ts).
 */
export interface Quest {
  /** Section id of the full write-up further down the page */
  id: string;
  title: Localized;
  /** One whole thought each, clear on its own; the section below has the detail */
  problem: Localized;
  solution: Localized;
}

interface Props {
  quests: Quest[];
}

const { quests } = Astro.props;
---

<div class="deck-wrap" data-quest-deck>
  <ul
    class="deck"
    data-quest-track
    tabindex="0"
    aria-label="Проблемы и решения"
    data-en-label="Problems and solutions"
  >
    {quests.map((q) => (
      <li class="quest px-clip" data-quest-card>
        <a class="title" href={`#${q.id}`} data-en={q.title.en}>
          {q.title.ru}
        </a>
        <p class="problem">
          <span class="visually-hidden" data-en="Before: ">
            Было:{' '}
          </span>
          <span data-en={q.problem.en}>{q.problem.ru}</span>
        </p>
        <span class="arrow" aria-hidden="true">
          <PixelIcon name="arrow" size={24} />
        </span>
        <p class="solution">
          <span class="visually-hidden" data-en="After: ">
            Стало:{' '}
          </span>
          <span data-en={q.solution.en}>{q.solution.ru}</span>
        </p>
      </li>
    ))}
  </ul>
  <div class="dots" aria-hidden="true">
    {quests.map((_, i) => (
      <span class:list={['dot', i === 0 && 'is-on']} data-quest-dot />
    ))}
  </div>
</div>

<style>
  .deck-wrap {
    container-type: inline-size;
  }
  .deck {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* The site's 24px frame between cards, more than a card's inner padding */
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quest {
    /* Holds the hidden "Было/Стало" labels: unanchored, they escaped the swipe deck and widened the page */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: var(--space-tile);
    background: var(--surface-raised);
  }

  /* Title, as on the HUD cards */
  .title {
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
    text-decoration: none;
  }
  .title:hover {
    color: var(--text-accent);
  }

  .problem,
  .solution {
    margin: 0;
  }
  .problem {
    font-size: var(--t-body);
    line-height: var(--lh-normal);
    color: var(--text-tertiary);
  }
  /* Down from the problem to the solution; arrow and solution sit at the bottom together, so the
     solutions line up across a row like the numbers on the HUD cards */
  .arrow {
    display: block;
    width: 20px;
    margin: auto 0 -4px;
    color: var(--text-disabled);
    transform: rotate(90deg);
  }
  .arrow :global(svg) {
    display: block;
    width: 20px;
    height: 20px;
  }
  /* The value, as the big number on the HUD cards */
  .solution {
    font-size: var(--t-lead);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }

  .dots {
    display: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phones: a deck that swipes one card at a time, the next one peeking in */
  @container (max-width: 560px) {
    .deck {
      display: flex;
      gap: 8px;
      margin: 0 calc(-1 * var(--pad, 16px));
      padding: 0 var(--pad, 16px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 var(--pad, 16px);
      scrollbar-width: none;
    }
    .deck::-webkit-scrollbar {
      display: none;
    }
    .quest {
      flex: 0 0 82%;
      min-height: 200px;
      scroll-snap-align: start;
    }
    .dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 14px;
    }
    .dot {
      width: 8px;
      height: 8px;
      background: var(--surface-active);
      transition: background var(--dur-fast) var(--ease-standard);
    }
    .dot.is-on {
      background: var(--accent);
    }
  }
</style>
