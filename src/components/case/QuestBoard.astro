---
import PixelIcon from '../ui/PixelIcon.astro';
import Sprite from './scenes/Sprite.astro';
import { mascotSprites, type MascotSpriteName } from '../../content/mascots';

/**
 * Problems and their solutions as a strip of four quests: sprite, title, the problem in a few
 * muted words, a pixel arrow down and the solution. Short columns in a row read as a rhythm of
 * four, not as text; numbers stay in the results HUD. Each title links to its full write-up.
 */
export interface Quest {
  /** Section id of the full write-up further down the page */
  id: string;
  title: string;
  sprite: MascotSpriteName;
  /** A few words: the column is narrow */
  problem: string;
  solution: string;
}

interface Props {
  quests: Quest[];
}

const { quests } = Astro.props;

// One pixel scale for every sprite, so a coin and a chest have pixels of the same size
const SCALE = 3;
const width = (name: MascotSpriteName) => mascotSprites[name][0].length * SCALE;
---

<div class="strip-wrap">
  <ul class="strip">
    {quests.map((q) => (
      <li class="quest">
        <span class="icon" aria-hidden="true">
          <span style={`width: ${width(q.sprite)}px`}>
            <Sprite name={q.sprite} />
          </span>
        </span>
        <a class="title" href={`#${q.id}`}>
          {q.title}
        </a>
        <p class="problem">{q.problem}</p>
        <span class="arrow" aria-hidden="true">
          <PixelIcon name="arrow" size={24} />
        </span>
        <p class="solution">
          <span class="visually-hidden">Решение: </span>
          {q.solution}
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .strip-wrap {
    container-type: inline-size;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px var(--space-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @container (max-width: 760px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .quest {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Sprites of different heights sit on one baseline, so the titles line up */
  .icon {
    display: flex;
    align-items: flex-end;
    height: 30px;
    margin-bottom: 14px;
  }
  .icon > span {
    display: block;
  }
  .icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .title {
    margin-bottom: 8px;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
    text-decoration: none;
  }
  .title:hover {
    color: var(--text-accent);
  }
  .problem,
  .solution {
    margin: 0;
    font-size: var(--t-body);
    line-height: var(--lh-snug);
  }
  .problem {
    color: var(--text-tertiary);
  }
  .solution {
    color: var(--text-primary);
  }
  /* Down from the problem to the solution */
  .arrow {
    display: block;
    margin: 6px 0;
    color: var(--accent);
    transform: rotate(90deg);
  }
  .arrow :global(svg) {
    width: 20px;
    height: 20px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
