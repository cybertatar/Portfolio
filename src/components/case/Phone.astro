---
import { withBase } from '../../scripts/url';

interface Props {
  /**
   * Screen in /public, 402×874pt (exported at 2x). Several screens stack in one body: the
   * last one shows until a script switches `is-on` (Race.astro).
   */
  src: string | string[];
  alt: string;
}

/**
 * A screen inside the iPhone 17 Pro body (the hidden "bezel" layer of the PSB Figma file:
 * 450×920pt, screen inset 24/23pt, 60pt corners). Scales with the width of its parent.
 */
const { src, alt } = Astro.props;
const screens = Array.isArray(src) ? src : [src];
const stacked = screens.length > 1;
---

<div class="phone">
  {screens.map((s, i) => (
    <img
      class:list={['screen', { stacked, 'is-on': i === screens.length - 1 }]}
      src={withBase(s)}
      alt={i === screens.length - 1 ? alt : ''}
      loading="lazy"
      decoding="async"
      data-screen={stacked ? '' : undefined}
    />
  ))}
  <img class="body" src={withBase('assets/iphone-17-pro.webp')} alt="" loading="lazy" />
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 450 / 920;
    container-type: inline-size;
  }
  /* Black under the screen, a little past it: the subpixel seam between the screen and the
     body's display border showed the page through as a light line around dark screens */
  .phone::before {
    content: '';
    position: absolute;
    left: calc(22 / 450 * 100%);
    top: calc(21 / 920 * 100%);
    width: calc(406 / 450 * 100%);
    height: calc(878 / 920 * 100%);
    border-radius: calc(62 / 450 * 100cqi);
    background: #000;
  }
  .screen {
    position: absolute;
    left: calc(24 / 450 * 100%);
    top: calc(23 / 920 * 100%);
    width: calc(402 / 450 * 100%);
    height: calc(874 / 920 * 100%);
    border-radius: calc(60 / 450 * 100cqi);
    object-fit: cover;
    object-position: top;
    background: #0e1116;
  }
  .screen.stacked:not(.is-on) {
    visibility: hidden;
  }
  /* Above every screen, a raised one too (the race lifts the screen sliding in): the dynamic
     island is part of the body and must never be covered */
  .body {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
