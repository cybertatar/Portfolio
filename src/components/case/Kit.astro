---
import { withBase } from '../../scripts/url';
import { kit } from '../../content/psb-kit';

/**
 * The PSB UI kit as a showcase: the foundations (colour tokens, the Onest type scale, icons in
 * three sizes), then every public component of the Figma kit in one explorer: pick a component
 * on the left, switch its variant properties under the stage, like the "passports" in Figma.
 * Variants are images cut from the Figma component sets (src/content/psb-kit.ts) on the kit's
 * #1E1E1E canvas, shown at their real size and scaled down only when taller than the stage.
 * Switching is initKit in scripts/case.ts; without JS the first variant of Button shows.
 */

interface Swatch {
  name: string;
  hex: string;
  /** Opacity, 0–1: drawn over a checkerboard */
  alpha?: number;
}
const colors: { group: string; items: Swatch[] }[] = [
  {
    group: 'Фоны',
    items: [
      { name: 'page', hex: '#0A0C0F' },
      { name: 'surface', hex: '#161A20' },
      { name: 'elevated', hex: '#242A33' },
      { name: 'overlay', hex: '#000000', alpha: 0.6 },
    ],
  },
  {
    group: 'Действия',
    items: [
      { name: 'action/primary', hex: '#E86630' },
      { name: 'action/neutral', hex: '#FFFFFF' },
      { name: 'action/secondary', hex: '#242A33' },
    ],
  },
  {
    group: 'Текст',
    items: [
      { name: 'primary', hex: '#FFFFFF' },
      { name: 'secondary', hex: '#FFFFFF', alpha: 0.5 },
      { name: 'tertiary', hex: '#CCCCCC' },
      { name: 'danger', hex: '#FE1818' },
      { name: 'success', hex: '#11C44C' },
    ],
  },
  {
    group: 'Иконки и обводки',
    items: [
      { name: 'icon/secondary', hex: '#A8A8BF' },
      { name: 'border/primary', hex: '#E9F0F3', alpha: 0.2 },
    ],
  },
];

const type = [
  { name: 'e-large', weight: 700, size: 32, line: 40, label: 'Bold', sample: 'Кешбэк 5%' },
  { name: 'large', weight: 700, size: 24, line: 32, label: 'Bold', sample: '11 726 777,61 ₽' },
  {
    name: 'medium',
    weight: 600,
    size: 20,
    line: 28,
    label: 'SemiBold',
    sample: 'Категории на октябрь',
  },
  {
    name: 'small',
    weight: 600,
    size: 16,
    line: 20,
    label: 'SemiBold',
    sample: 'Мои карты и счета',
  },
  {
    name: 'm',
    weight: 400,
    size: 16,
    line: 20,
    label: 'Regular',
    sample: 'Выберите три категории',
  },
  {
    name: 'm-medium',
    weight: 500,
    size: 16,
    line: 20,
    label: 'Medium',
    sample: 'Подключить кешбэк',
  },
  {
    name: 'caption',
    weight: 400,
    size: 12,
    line: 16,
    label: 'Regular',
    sample: 'Начислим до 30 числа',
  },
  {
    name: 'caption-medium',
    weight: 500,
    size: 12,
    line: 16,
    label: 'Medium',
    sample: 'Номер карты',
  },
];

const icons = [
  {
    name: 'large',
    size: 32,
    items: ['l-send', 'l-qrcode', 'l-add', 'l-sbp', 'l-card', 'l-settings', 'l-add2'],
  },
  {
    name: 'medium',
    size: 24,
    items: [
      'm-cashback',
      'm-bankcard',
      'm-hide',
      'm-show',
      'm-more',
      'm-chat',
      'm-heart',
      'm-exchange',
      'm-logo',
      'm-add',
      'm-minus',
      'm-close',
      'm-arrow-back',
      'm-arrow-forward',
      'm-send',
      'm-add2',
      'm-copy',
      'm-search',
      'm-bell',
      'm-faq',
    ],
  },
  {
    name: 'small',
    size: 16,
    items: [
      's-show',
      's-hide',
      's-cashback',
      's-bankcard',
      's-close',
      's-copy',
      's-edit',
      's-triangle-up',
      's-triangle-down',
      's-back',
      's-arrow-opened',
      's-arrow-closed',
      's-check',
    ],
  },
];

// The variant a component opens on: the first one, or a mid-size one where the first is the
// smallest of a size axis
const starts: Record<string, Record<string, string>> = {
  button: { type: 'primary', color: 'accent', size: 'medium', radius: 'circle' },
  icnbutton: { size: 'large', type: 'accent', color: 'primary', radius: 'circle', glass: 'false' },
};
// Image paths with the site base, for the explorer script
const data = kit.map((c) => {
  const want = starts[c.id];
  const start = want
    ? Math.max(
        0,
        c.variants.findIndex((v) => Object.entries(want).every(([k, x]) => v.props[k] === x)),
      )
    : 0;
  return { ...c, start, variants: c.variants.map((v) => ({ ...v, src: withBase(v.src) })) };
});
const first = data[0];
const firstVariant = first.variants[first.start];
---

<link rel="stylesheet" href={withBase('assets/cases/psb/live/fonts.css')} />

<div class="kit">
  <!-- ---------- Foundations ---------- -->
  <div class="found">
    <article class="card px-clip">
      <header class="head">
        <h3 class="title">Цвета</h3>
        <p class="desc">Семантические токены: каждый назван по роли, а не по цвету.</p>
      </header>
      <div class="groups">
        {colors.map((g) => (
          <div class="group">
            <p class="group-name">{g.group}</p>
            <ul class="swatches">
              {g.items.map((s) => (
                <li class="swatch">
                  <span
                    class:list={['chip px-clip', { alpha: s.alpha !== undefined }]}
                    style={`--c: ${s.hex}; --a: ${s.alpha ?? 1}`}
                  />
                  <span class="sw-text">
                    <span class="sw-name">{s.name}</span>
                    <span class="sw-hex">
                      {s.hex}
                      {s.alpha !== undefined && ` · ${Math.round(s.alpha * 100)}%`}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </article>

    <article class="card px-clip">
      <header class="head">
        <h3 class="title">Типографика</h3>
        <p class="desc">Onest: четыре заголовка и четыре наборных стиля.</p>
      </header>
      <ul class="type">
        {type.map((t) => (
          <li class="type-row">
            <span class="type-meta">
              <span class="type-name">{t.name}</span>
              <span class="type-spec">
                {t.label} {t.size}/{t.line}
              </span>
            </span>
            <span
              class="type-sample"
              style={`font-weight: ${t.weight}; font-size: ${t.size}px; line-height: ${t.line}px`}
            >
              {t.sample}
            </span>
          </li>
        ))}
      </ul>
    </article>
  </div>

  <article class="card px-clip">
    <header class="head">
      <h3 class="title">Иконки</h3>
      <p class="desc">Три размера на одной сетке: 32, 24 и 16 пикселей.</p>
    </header>
    <div class="stage icons-stage px-clip">
      {icons.map((set) => (
        <div class="icon-set">
          <p class="kit-caption">
            {set.name} · {set.size}px
          </p>
          <ul class="icon-grid" style={`--s: ${set.size}px`}>
            {set.items.map((name) => (
              <li>
                <img
                  src={withBase(`assets/cases/psb/kit/icons/${name}.svg`)}
                  alt={name}
                  title={name}
                  width={set.size}
                  height={set.size}
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </article>

  <!-- ---------- Components: one explorer ---------- -->
  <article class="card px-clip" data-kit>
    <header class="head">
      <h3 class="title">Компоненты</h3>
      <p class="desc">
        {data.length} компонентов, {data.reduce((n, c) => n + c.variants.length, 0)} вариантов.
        Выберите компонент и переключайте его свойства.
      </p>
    </header>
    <div class="explorer">
      <div class="list" role="radiogroup" aria-label="Компонент">
        {data.map((c, i) => (
          <label class="item">
            <input type="radio" name="kit-component" value={c.id} checked={i === 0} />
            <span class="item-face px-clip">{c.title}</span>
          </label>
        ))}
      </div>
      <div class="view">
        <div class="stage stage-kit px-clip">
          <img
            class="variant"
            data-kit-img
            src={firstVariant.src}
            alt={`${first.title}: ${Object.values(firstVariant.props).join(', ')}`}
            width={firstVariant.w}
            height={firstVariant.h}
            style={`--w: ${firstVariant.w}; --h: ${firstVariant.h}`}
          />
        </div>
        {data.map((c, i) => (
          <div class="panel" data-kit-panel={c.id} hidden={i !== 0}>
            <p class="panel-desc">{c.desc}</p>
            <div class="axes">
              {c.axes
                .filter((a) => a.values.length > 1)
                .map((a) => (
                  <div
                    class="axis"
                    role="radiogroup"
                    aria-labelledby={`kit-${c.id}-${a.name}`}
                    data-axis={a.name}
                  >
                    <span class="axis-name" id={`kit-${c.id}-${a.name}`}>
                      {a.name}
                    </span>
                    <span class="opts">
                      {a.values.map((v) => (
                        <label class="opt">
                          <input
                            type="radio"
                            name={`kit-${c.id}-${a.name}`}
                            value={v}
                            checked={c.variants[c.start].props[a.name] === v}
                          />
                          <span class="opt-face px-clip">{v}</span>
                        </label>
                      ))}
                    </span>
                  </div>
                ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <script type="application/json" data-kit-data set:html={JSON.stringify(data)} />
  </article>
</div>

<style>
  .kit {
    --kit-page: #0a0c0f;
    --kit-onest: 'Onest Variable', Onest, system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    gap: 24px;
    container-type: inline-size;
  }
  .found {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 24px;
  }

  /* Cards like the quest and HUD cards: raised paper, pixel corners, title over content */
  .card {
    --px-step: 3px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: var(--space-tile);
    background: var(--surface-raised);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title {
    margin: 0;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  .desc {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* ---------- Colours ---------- */

  .groups {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .group-name,
  .axis-name {
    margin: 0 0 8px;
    padding: 0;
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .swatch {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .chip {
    --px-step: 2px;
    flex: none;
    width: 36px;
    height: 36px;
    background: var(--c);
  }
  /* See-through tokens over the kit's own dark page, checkered like in Figma */
  .chip.alpha {
    background:
      linear-gradient(
        color-mix(in srgb, var(--c) calc(var(--a) * 100%), transparent),
        color-mix(in srgb, var(--c) calc(var(--a) * 100%), transparent)
      ),
      repeating-conic-gradient(#242a33 0 25%, var(--kit-page) 0 50%) 0 0 / 12px 12px;
  }
  .sw-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sw-name {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--t-chip);
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-primary);
  }
  .sw-hex {
    font-family: var(--font-mono);
    font-size: var(--t-chip);
    color: var(--text-tertiary);
  }

  /* ---------- Type ---------- */

  .type {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .type-row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 10px 0;
    border-top: var(--border-width-keyline) solid var(--border-default);
  }
  .type-row:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .type-meta {
    display: flex;
    flex-direction: column;
  }
  .type-name {
    font-family: var(--font-mono);
    font-size: var(--t-chip);
    color: var(--text-primary);
  }
  .type-spec {
    font-size: var(--t-caption);
    color: var(--text-tertiary);
  }
  .type-sample {
    overflow: hidden;
    font-family: var(--kit-onest);
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-primary);
  }

  /* ---------- Kit stage: the kit's own dark page ---------- */

  .stage {
    --px-step: 3px;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 24px;
    background: var(--kit-page);
    font-family: var(--kit-onest);
    color: #fff;
    isolation: isolate;
  }
  .kit-caption {
    margin: 0 0 12px;
    font-family: var(--kit-onest);
    font-size: 12px;
    line-height: 16px;
    color: rgba(255, 255, 255, 0.5);
  }

  .icons-stage {
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 32px;
    place-items: start;
    padding: 24px 28px;
  }
  .icon-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .icon-set:first-child .icon-grid {
    max-width: calc(4 * 32px + 3 * 8px);
  }
  .icon-set:last-child .icon-grid {
    max-width: calc(5 * 16px + 4 * 8px);
  }
  .icon-grid img {
    display: block;
    width: var(--s);
    height: var(--s);
  }

  /* ---------- Components explorer ---------- */

  .explorer {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .item,
  .opt {
    position: relative;
  }
  .item input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .item-face {
    --px-step: 2px;
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    font-size: var(--t-caption);
    color: var(--text-secondary);
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .item:hover .item-face {
    background: var(--surface-active);
  }
  .item input:checked + .item-face {
    background: var(--surface-card);
    font-weight: var(--fw-medium);
    color: var(--text-accent);
  }
  .item input:focus-visible + .item-face {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }
  .view {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  /* The kit's own Figma canvas, so the cut variants sit on it without seams */
  .stage-kit {
    /* Height of the stage's content box: tall variants (whole screens) scale to it */
    --sh: 392;
    height: calc(var(--sh) * 1px + 48px);
    padding: 24px;
    background: #1e1e1e;
  }
  /* Real size (1 Figma px = 1 CSS px), scaled down only to fit the stage */
  .variant {
    display: block;
    width: min(calc(var(--w) * 1px), 100%, calc(var(--sh) * var(--w) / var(--h) * 1px));
    height: auto;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-desc {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }

  /* ---------- Axis switches: the variant properties of the Figma component ---------- */

  .axes {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .axis {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-width: 0;
  }
  .axis-name {
    margin: 0;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .opt input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .opt-face {
    --px-step: 2px;
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: var(--t-chip);
    color: var(--text-secondary);
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .opt:hover .opt-face {
    background: var(--surface-active);
  }
  .opt input:checked + .opt-face {
    background: var(--surface-card);
    color: var(--text-accent);
  }
  .opt input:focus-visible + .opt-face {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }
  .opt input:disabled,
  .opt input:disabled + .opt-face {
    color: var(--text-disabled);
    background: none;
    cursor: default;
  }

  /* ---------- Narrow sheet ---------- */

  @container (max-width: 860px) {
    .found {
      grid-template-columns: minmax(0, 1fr);
    }
    /* The list becomes a row of chips that scrolls sideways */
    .explorer {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .list {
      flex-direction: row;
      margin: 0 calc(var(--space-tile) * -1);
      padding: 0 var(--space-tile);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .item-face {
      white-space: nowrap;
    }
  }
  @container (max-width: 560px) {
    .icons-stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .icon-set .icon-grid {
      max-width: none !important;
    }
    .type-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .type-meta {
      flex-direction: row;
      gap: 8px;
    }
    .axis {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .stage {
      padding: 20px 16px;
    }
    .stage-kit {
      --sh: 280;
      padding: 20px 16px;
      height: calc(var(--sh) * 1px + 40px);
    }
    /* One column, name and hex on one line: two columns cut the token names */
    .swatches {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .chip {
      width: 28px;
      height: 28px;
    }
    .sw-text {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: 10px;
    }
  }
</style>
