---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Button from '../components/ui/Button.astro';
import ContactRow from '../components/ui/ContactRow.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import IconButton from '../components/ui/IconButton.astro';
import Media from '../components/ui/Media.astro';
import PixelIcon from '../components/ui/PixelIcon.astro';
import { cases, profile, ui } from '../content/site';

const upcoming = cases.filter((c) => c.status === 'soon').length;
const done = cases.length - upcoming;
---

<BaseLayout title={`${profile.name.ru} — ${profile.role}`} description={profile.bio.ru}>
  <div class="root">
    <aside class="aside px-clip" data-stage="0" data-profile>
      <div class="head">
        <div class="portrait">
          <div class="portrait-media px-clip">
            <Media src={profile.portrait} label={ui.portrait} />
          </div>
          <span class="lvl px-clip">
            <span class="lvl-num">{profile.level}</span>
            <span class="lvl-label" data-en={ui.level.en}>
              {ui.level.ru}
            </span>
          </span>
        </div>
        <div class="name">
          <h1 data-en={profile.name.en}>{profile.name.ru}</h1>
          <p class="role">
            <span class="role-label" data-en={ui.class.en}>
              {ui.class.ru}
            </span>
            <span>{profile.role}</span>
          </p>
        </div>
      </div>

      <div class="bio">
        <p data-en={profile.bio.en}>{profile.bio.ru}</p>
      </div>

      <div class="zone zone-gear">
        <Eyebrow data-en={ui.equipment.en}>{ui.equipment.ru}</Eyebrow>
        <ul class="gear">
          {profile.tools.map((tool) => (
            <li
              class="gear-item px-clip"
              tabindex="0"
              data-tip={tool.name}
              data-tip-type={ui.tool.ru}
              data-tip-type-en={ui.tool.en}
              data-tip-text={tool.kind.ru}
              data-tip-text-en={tool.kind.en}
            >
              <PixelIcon name={tool.icon} />
              <span class="gear-name">{tool.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="zone zone-contacts">
        {profile.contacts.map((c, i) => (
          <ContactRow
            href={c.href}
            value={c.value}
            label={c.label}
            icon={c.icon}
            external={c.external}
            divider={i < profile.contacts.length - 1}
          />
        ))}
      </div>

      <div class="cta">
        <Button href={profile.cvHref} full>
          CV
        </Button>
        <IconButton href={profile.telegramHref} label="Telegram" target="_blank" rel="noopener">
          <PixelIcon name="telegram" />
        </IconButton>
      </div>
    </aside>

    <main class="feed" data-feed>
      <div class="inner">
        <header class="log-head">
          <Eyebrow data-en={ui.questLog.en}>{ui.questLog.ru}</Eyebrow>
          <span class="log-count">
            <span data-en={`${ui.completed.en}: ${done}`}>{`${ui.completed.ru}: ${done}`}</span>
            <span aria-hidden="true">·</span>
            <span
              data-en={`${ui.upcoming.en}: ${upcoming}`}
            >{`${ui.upcoming.ru}: ${upcoming}`}</span>
          </span>
        </header>

        <div class="list">
          {cases.map((item, i) => (
            <article class:list={['slot', { last: i === cases.length - 1 }]} data-slot>
              <ProjectCard item={item} number={i + 1} />
            </article>
          ))}
        </div>

        <footer class="footer">
          <Eyebrow tone="secondary" data-en={ui.footer.en}>
            {ui.footer.ru}
          </Eyebrow>
        </footer>
        <div class="spacer" aria-hidden="true" data-spacer></div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { initCardStack, initProfileFit, initTooltips } from '../scripts/home';

  const aside = document.querySelector<HTMLElement>('[data-profile]');
  const feed = document.querySelector<HTMLElement>('[data-feed]');
  if (aside) initProfileFit(aside);
  initTooltips();
  if (feed) {
    initCardStack(
      feed,
      [...document.querySelectorAll<HTMLElement>('[data-slot]')],
      document.querySelector<HTMLElement>('[data-spacer]'),
    );
  }
</script>

<style>
  .root {
    /* Empty space on each side once the screen is wider than the content */
    --side: max(0px, (100vw - var(--layout-content-max)) / 2);
    display: flex;
    align-items: flex-start;
    height: 100vh;
    overflow: hidden;
    background: var(--surface-page);
  }

  /* ---------- Profile aside ---------- */

  .aside {
    flex: 0 0 25%;
    min-width: var(--layout-sidebar-min);
    max-width: var(--layout-sidebar-max);
    align-self: flex-start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    overflow-x: hidden;
    margin: 24px 0 24px calc(var(--side) + 24px);
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 1.2vw, 28px);
    background: var(--surface-card);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: none;
    min-width: 0;
  }
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    flex: none;
  }
  .portrait-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--text-tertiary);
  }

  /* Level badge: sits on the portrait's bottom edge, like a unit frame in an MMO */
  .lvl {
    --px-step: 2px;
    position: absolute;
    left: 12px;
    bottom: -14px;
    display: flex;
    align-items: baseline;
    gap: 5px;
    height: 32px;
    padding: 0 10px;
    background: var(--ink-0);
    font-family: var(--font-pixel);
    line-height: 32px;
    white-space: nowrap;
    color: var(--text-primary);
  }
  .lvl-num {
    font-size: 26px;
    font-weight: var(--fw-bold);
  }
  .lvl-label {
    font-size: 15px;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .name {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    margin-top: clamp(28px, 1.8vw, 34px);
  }
  h1 {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(var(--t-name) * 1.25);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--text-primary);
  }
  .role {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    font-size: var(--t-button);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
  }
  .role-label {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .bio {
    flex: none;
    margin-top: var(--space-zone);
  }
  .bio p {
    margin: 0;
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .zone {
    display: flex;
    flex-direction: column;
    flex: none;
    padding-top: var(--space-zone);
  }
  .zone-gear {
    gap: 12px;
  }
  .zone-contacts {
    gap: 2px;
  }

  /* Equipment: tools as inventory slots */
  .gear {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gear-item {
    --px-step: 2px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    height: var(--chip-h);
    padding: 0 10px;
    background: var(--surface-raised);
    color: var(--text-primary);
    cursor: default;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .gear-item:hover,
  .gear-item:focus-visible {
    background: var(--surface-active);
    outline: none;
  }
  .gear-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--t-chip);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    margin-top: clamp(24px, 1.8vw, 32px);
  }

  /* Height fit, stage 1+: tighter rhythm */
  .aside:not([data-stage='0']) .bio {
    margin-top: 24px;
  }
  .aside:not([data-stage='0']) .zone {
    padding-top: 24px;
  }
  .aside:not([data-stage='0']) .cta {
    margin-top: 16px;
  }

  /* Stage 2+: compact header in a row with a small square portrait */
  .aside:is([data-stage='2'], [data-stage='3']) .head {
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .portrait {
    width: 72px;
    height: 72px;
    aspect-ratio: auto;
    flex: 0 0 72px;
  }
  /* The square crop zooms in on the face: its centre lands at ~34% / 37% of the frame. */
  .aside:is([data-stage='2'], [data-stage='3']) .portrait-media :global(img) {
    transform-origin: 34% 37%;
    transform: translate(16%, 13%) scale(1.8);
  }
  .aside:is([data-stage='2'], [data-stage='3']) .lvl {
    left: auto;
    right: -10px;
    bottom: -8px;
    height: 24px;
    padding: 0 6px;
    line-height: 24px;
    gap: 3px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .lvl-num {
    font-size: 19px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .lvl-label {
    font-size: 13px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .name {
    margin-top: 0;
  }
  .aside:is([data-stage='2'], [data-stage='3']) h1 {
    font-size: 27px;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .role {
    font-size: 14px;
  }

  /* Stage 3: drop the bio */
  .aside[data-stage='3'] .bio {
    display: none;
  }

  /* ---------- Feed ---------- */

  .feed {
    flex: 1 1 auto;
    min-width: 0;
    height: 100vh;
    /* Padding, not margin: the feed scrolls, so its scrollbar and wheel area
       stay at the screen edge */
    padding-right: var(--side);
    overflow-y: auto;
    overflow-x: hidden;
  }
  .inner {
    width: 100%;
    max-width: var(--layout-feed-max);
    margin: 0 auto;
    padding: 24px 40px 0;
  }
  .log-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 32px;
    margin-bottom: 16px;
  }
  .log-count {
    display: flex;
    gap: 8px;
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--layout-feed-gap);
  }
  .slot {
    position: sticky;
    top: 24px;
    will-change: transform;
  }
  .last {
    height: 86vh;
    min-height: 600px;
  }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 96px;
    border-top: var(--border-width-hair) solid var(--border-subtle);
    margin-top: 48px;
  }
  .spacer {
    height: 0;
  }

  /* ---------- Mobile / tablet portrait ---------- */

  @media (max-width: 960px) {
    .root {
      display: block;
      height: auto;
      overflow-x: clip;
      overflow-y: visible;
    }
    .aside {
      width: calc(100% - 32px);
      max-width: 640px;
      min-width: 0;
      max-height: none;
      overflow: visible;
      margin: 16px auto 0;
    }
    .feed {
      height: auto;
      padding-right: 0;
      overflow: visible;
    }
    .inner {
      max-width: 672px;
      padding: 16px 16px 0;
    }
    .list {
      gap: 16px;
    }
    .slot {
      top: 16px;
    }
    .last {
      height: auto;
      min-height: 0;
    }
  }
</style>
