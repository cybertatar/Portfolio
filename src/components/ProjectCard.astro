---
import { ui, type CaseItem } from '../content/site';
import GlassTag from './ui/GlassTag.astro';
import IconButton from './ui/IconButton.astro';
import Media from './ui/Media.astro';
import PixelIcon from './ui/PixelIcon.astro';
import { withBase } from '../scripts/url';

interface Props {
  item: CaseItem;
}

/** Home-feed card for one case: 16:9 cover, title + description, arrow or lock. */
const { item } = Astro.props;
const soon = item.status === 'soon';
const nda = item.status === 'nda';
const locked = soon || nda;
const Tag = locked ? 'div' : 'a';
const msg = nda ? ui.noWay : ui.noMana;
const lockLabel = nda ? { ru: 'NDA', en: 'NDA' } : ui.locked;
// A locked case is a button that answers with a dialog (initLocked in home.ts): "not enough
// mana" while it is coming, "no road to these lands" for a case under NDA.
const linkProps = locked
  ? ({
      role: 'button',
      tabindex: 0,
      'data-locked': '',
      'data-msg': msg.ru,
      'data-msg-en': msg.en,
      'aria-label': `${item.title}: ${lockLabel.ru}`,
      'data-en-label': `${item.title}: ${lockLabel.en}`,
    } as const)
  : {
      href: item.href && item.href !== '#' ? withBase(item.href) : '#',
      'aria-label': `${ui.openCase.ru}: ${item.title}`,
      'data-en-label': `${ui.openCase.en}: ${item.title}`,
    };
---

<Tag class:list={['card', 'px-clip', { closed: locked }]} {...linkProps}>
  <div class="cover px-clip">
    <div class="cover-media">
      <Media src={item.cover} label={item.coverLabel} />
    </div>
    {soon && (
      <div class:list={['locked', { 'over-cover': item.cover }]}>
        <span class="lock" data-lock>
          <PixelIcon name="lock" size={48} />
        </span>
        <span data-en={ui.locked.en}>{ui.locked.ru}</span>
      </div>
    )}
    {/* An NDA case keeps its cover clear: the lock sits in an "NDA" tag instead */}
    {(item.tags.length > 0 || nda) && (
      <div class="tags">
        {nda && (
          <GlassTag>
            <span class="nda">
              <span class="lock" data-lock>
                <PixelIcon name="lock" size={16} />
              </span>
              NDA
            </span>
          </GlassTag>
        )}
        {item.tags.map((tag) => (
          <GlassTag>{tag}</GlassTag>
        ))}
      </div>
    )}
  </div>
  <div class="body">
    <div class="text">
      <h2 class="title">{item.title}</h2>
      <p class="description" data-en={item.description.en}>
        {item.description.ru}
      </p>
    </div>
    {!locked && (
      <IconButton shape="large">
        <PixelIcon name="arrow" />
      </IconButton>
    )}
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    text-decoration: none;
    background: var(--surface-card);
    color: inherit;
  }
  .card:hover {
    color: inherit;
  }
  .cover {
    position: relative;
    flex: none;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    color: var(--text-tertiary);
  }
  .cover-media {
    position: absolute;
    inset: 0;
    transform: scale(1);
    transition: transform var(--dur-slower) var(--ease-standard);
    will-change: transform;
  }
  .card:hover .cover-media {
    transform: scale(var(--cover-zoom));
  }
  /* Locked quest: the cover is replaced by a lock */
  .locked {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--surface-sunken);
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  /* A locked case with its own cover shows the lock on top of it */
  .locked.over-cover {
    background: none;
  }
  .lock {
    display: block;
  }
  /* Shake on click: short, stepped, like a sprite */
  .lock:global(.is-shaking) {
    animation: shake 360ms steps(1, end);
  }
  @keyframes shake {
    0%,
    50% {
      transform: translateX(-4px);
    }
    25%,
    75% {
      transform: translateX(4px);
    }
    100% {
      transform: none;
    }
  }
  .tags {
    position: absolute;
    right: 16px;
    top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 0.6vw, 14px);
    flex: 1 1 auto;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-size: var(--t-card-title);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tighter);
    color: var(--text-primary);
  }
  .nda {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .closed .title,
  .closed .description {
    color: var(--text-tertiary);
  }
  .description {
    margin: 0;
    font-size: var(--t-card-sub);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }

  /* Mobile: inner padding no larger than the 16px gaps around the card */
  @media (max-width: 960px) {
    .card {
      gap: 16px;
      padding: 16px;
    }
  }
</style>
