---
interface Props {
  /** The one chapter's name for a clip without key moments (LoopVideo). */
  label?: string;
  enLabel?: string;
}

/**
 * Pause and a timeline under a looping scene: the loop cut into chapters at its key moments,
 * each named under its bar; the current one fills, a click jumps to it. runScene or
 * playWhileShown (scripts/scenes.ts) fill it in; without JS it stays hidden.
 */
const { label, enLabel } = Astro.props;
---

<div
  class="scene-controls"
  data-scene-controls
  data-chapter-name={label}
  data-en-chapter-name={enLabel}
  hidden
>
  <button class="toggle px-clip" type="button" data-scene-toggle aria-label="Пауза">
    <svg
      class="icon-pause"
      viewBox="0 0 12 12"
      width="18"
      height="18"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <path fill="currentColor" d="M3 2h2v8H3zM7 2h2v8H7z"></path>
    </svg>
    <svg
      class="icon-play"
      viewBox="0 0 12 12"
      width="18"
      height="18"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <path fill="currentColor" d="M3 1h1v10H3zM4 2h1v8H4zM5 3h1v6H5zM6 4h1v4H6zM7 5h1v2H7z"></path>
    </svg>
    <svg
      class="icon-replay"
      viewBox="0 0 12 12"
      width="18"
      height="18"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        d="M5 1h4v1H5zM3 2h2v1H3zM9 2h1v1H9zM2 3h1v1H2zM10 3h1v5h-1zM1 4h3v1H1zM0 5h5v1H0zM2 7h1v1H2zM3 8h1v1H3zM9 8h1v1H9zM4 9h5v1H4z"
      ></path>
    </svg>
  </button>
  <div class="track" data-scene-track></div>
</div>

<style>
  .scene-controls {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .scene-controls[hidden] {
    display: none;
  }
  .toggle {
    --px-step: 2px;
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: var(--surface-active);
    color: var(--text-primary);
    cursor: inherit;
  }
  .toggle:hover {
    background: var(--line-1);
  }
  .toggle:not([data-playing='false']) .icon-play,
  .toggle:not([data-playing='true']) .icon-pause,
  .toggle:not([data-playing='done']) .icon-replay {
    display: none;
  }
  .track {
    display: flex;
    flex: 1;
    gap: 4px;
    min-width: 0;
  }
  /* A chapter: its bar level with the button's middle, its name under it */
  .track :global(.chapter) {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 14px 0 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: inherit;
  }
  .track :global(.chapter-bar) {
    display: block;
    height: 4px;
    overflow: hidden;
    background: var(--line-1);
  }
  .track :global(.chapter-fill) {
    display: block;
    height: 100%;
    background: var(--sky-400);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .track :global(.chapter-name) {
    overflow: hidden;
    font-size: var(--t-caption);
    line-height: var(--lh-snug);
    color: var(--text-tertiary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .track :global(.chapter[data-current] .chapter-name),
  .track :global(.chapter:hover .chapter-name) {
    color: var(--text-primary);
  }
  .track :global(.chapter:focus-visible) {
    outline-offset: 4px;
  }
</style>
