---
import { ui, type CaseItem } from '../content/site';
import GlassTag from './ui/GlassTag.astro';
import IconButton from './ui/IconButton.astro';
import Media from './ui/Media.astro';
import PixelIcon from './ui/PixelIcon.astro';

interface Props {
  item: CaseItem;
  /** Position in the quest log, from 1. */
  number: number;
}

/** Home-feed card for one case, styled as a quest-log entry: 16:9 cover, quest line, title + description. */
const { item, number } = Astro.props;
const soon = item.status === 'soon';
const featured = item.status === 'featured';
const quest = String(number).padStart(2, '0');
const Tag = soon ? 'div' : 'a';
const linkProps = soon
  ? {}
  : {
      href: item.href ?? '#',
      'aria-label': `${ui.openCase.ru}: ${item.title}`,
      'data-en-label': `${ui.openCase.en}: ${item.title}`,
    };
---

<Tag class:list={['card', 'px-clip', { soon }]} {...linkProps}>
  <div class="cover px-clip">
    <div class="cover-media">
      <Media src={item.cover} label={item.coverLabel} />
    </div>
    {soon && (
      <div class="locked">
        <PixelIcon name="lock" size={48} />
        <span data-en={ui.locked.en}>{ui.locked.ru}</span>
      </div>
    )}
    {item.tags.length > 0 && (
      <div class="tags">
        {item.tags.map((tag) => (
          <GlassTag>{tag}</GlassTag>
        ))}
      </div>
    )}
  </div>
  <div class="body">
    <div class="text">
      <p class="quest">
        {featured && (
          <span class="main">
            <span aria-hidden="true">!</span>
            <span data-en={ui.mainQuest.en}>{ui.mainQuest.ru}</span>
          </span>
        )}
        <span data-en={`${ui.quest.en} ${quest}`}>{`${ui.quest.ru} ${quest}`}</span>
      </p>
      <h2 class="title">{item.title}</h2>
      <p class="description" data-en={item.description.en}>
        {item.description.ru}
      </p>
    </div>
    {!soon && (
      <IconButton shape="large" tone={featured ? 'inverse' : 'raised'}>
        <PixelIcon name="arrow" />
      </IconButton>
    )}
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    text-decoration: none;
    background: var(--surface-card);
    color: inherit;
  }
  .card:hover {
    color: inherit;
  }
  .cover {
    position: relative;
    flex: none;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    color: var(--text-tertiary);
  }
  .cover-media {
    position: absolute;
    inset: 0;
    transform: scale(1);
    transition: transform var(--dur-slower) var(--ease-standard);
    will-change: transform;
  }
  .card:hover .cover-media {
    transform: scale(var(--cover-zoom));
  }
  /* Locked quest: the cover is replaced by a lock */
  .locked {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--ink-1);
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .tags {
    position: absolute;
    right: 16px;
    top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 0.6vw, 14px);
    flex: 1 1 auto;
    min-width: 0;
  }
  .quest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .main {
    display: flex;
    gap: 6px;
    color: var(--text-accent);
  }
  .title {
    margin: 0;
    font-size: var(--t-card-title);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tighter);
    color: var(--text-primary);
  }
  .soon .title,
  .soon .description {
    color: var(--text-tertiary);
  }
  .description {
    margin: 0;
    font-size: var(--t-card-sub);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }
</style>
