/** Contents: the sidebar on desktop, the drop-down list on mobile. `sub` items are indented. */
const toc: { id: string; title: Localized; group?: Localized; sub?: boolean }[] = [
  { id: 'overview', title: { ru: 'Обзор', en: 'Overview' } },
  { id: 'screens', title: { ru: 'Финальные экраны', en: 'Final screens' } },
  { id: 'process', title: { ru: 'Как мы работали', en: 'How we worked' } },
  { id: 'interviews', title: { ru: 'Интервью', en: 'Interviews' } },
  {
    id: 'home',
    title: { ru: 'Главная', en: 'Home' },
    group: { ru: 'Решения', en: 'Solutions' },
  },
  { id: 'card-data', title: { ru: 'Данные карты', en: 'Card details' }, sub: true },
  { id: 'cashback', title: { ru: 'Подключение кешбэка', en: 'Activating cashback' }, sub: true },
  {
    id: 'categories',
    title: { ru: 'Кешбэк после подключения', en: 'Cashback after activation' },
    sub: true,
  },
  { id: 'testing', title: { ru: 'Тестирование', en: 'Testing' } },
  { id: 'review', title: { ru: 'Ревью', en: 'Review' } },
  { id: 'outcome', title: { ru: 'Выводы', en: 'Takeaways' } },
];

/** Final screens: one live prototype per flow from the usability test. */
const prototypes = [
  { route: '/', poster: 'assets/cases/psb/main.webp', caption: { ru: 'Главная', en: 'Home' } },
  {
    route: '/card',
    poster: 'assets/cases/psb/card.webp',
    caption: { ru: 'Данные карты', en: 'Card details' },
  },
  {
    route: '/cashback',
    poster: 'assets/cases/psb/cb-off.webp',
    caption: { ru: 'Подключение кешбэка', en: 'Activating cashback' },
  },
];

/** Each problem and its solution, one quest per solution section below: one whole thought each, clear without the section */
const quests: Quest[] = [
  {
    id: 'home',
    title: { ru: 'Главная', en: 'Home' },
    problem: {
      ru: 'Промо и продукты банка спорили с повседневными действиями, историю было трудно найти',
      en: 'Bank promos and products competed with everyday actions, and the history was hard to find',
    },
    solution: {
      ru: 'Баланс, частые действия и история наверху, а предложения банка можно закрыть',
      en: 'Balance, frequent actions and history at the top, and bank offers can be closed',
    },
  },
  {
    id: 'card-data',
    title: { ru: 'Данные карты', en: 'Card details' },
    problem: {
      ru: 'Данные лежали на третьей вкладке, а CVV открывался только по коду из СМС',
      en: 'The details were on the third tab, and the CVV was only shown after entering a code from a text message',
    },
    solution: {
      ru: 'Их можно посмотреть и скопировать на одном экране, без кода из СМС',
      en: 'They can be viewed and copied on one screen, with no text message code',
    },
  },
  {
    id: 'cashback',
    title: { ru: 'Подключение кешбэка', en: 'Activating cashback' },
    problem: {
      ru: '12 шагов через почту и браузер, а подключённый кешбэк не появлялся, пока не перезайдёшь в приложение',
      en: '12 steps through email and a browser, and the activated cashback didn’t show up until you reopened the app',
    },
    solution: {
      ru: 'Одна кнопка рядом с условиями, и сразу выбор категорий',
      en: 'One button next to the terms, and straight on to choosing categories',
    },
  },
  {
    id: 'categories',
    title: { ru: 'Кешбэк после подключения', en: 'Cashback after activation' },
    problem: {
      ru: 'Категории нужно было выбирать каждый месяц, а приложение об этом не напоминало',
      en: 'Categories had to be chosen every month, and the app never reminded you',
    },
    solution: {
      ru: 'Их можно выбрать на месяц вперёд и поменять до его начала',
      en: 'They can be chosen a month ahead and changed before it starts',
    },
  },
];

// One row of stats, all built the same: number, context, one gauge
const stats: HudStat[] = [
  {
    label: { ru: 'Подключение кешбэка', en: 'Activating cashback' },
    value: '23',
    unit: { ru: 'с', en: 's' },
    notes: [
      { ru: 'вместо 105 с', en: 'instead of 105 s' },
      { ru: '5 шагов вместо 12', en: '5 steps instead of 12' },
    ],
    gauge: { kind: 'time', from: 105, to: 23 },
  },
  {
    label: { ru: 'Путь к данным карты', en: 'Getting to card details' },
    value: '17',
    unit: { ru: 'с', en: 's' },
    notes: [
      { ru: 'вместо 42 с', en: 'instead of 42 s' },
      { ru: '4 шага вместо 7', en: '4 steps instead of 7' },
    ],
    gauge: { kind: 'time', from: 42, to: 17 },
  },
  {
    label: 'First click success',
    value: '89%',
    notes: [{ ru: 'начали с правильного действия', en: 'started with the right action' }],
    gauge: { kind: 'mana', value: 89 },
  },
  {
    label: { ru: 'Оценка лёгкости', en: 'Ease score' },
    value: { ru: '6,4', en: '6.4' },
    unit: { ru: 'из 7', en: 'of 7' },
    notes: [{ ru: 'SEQ, среднее по задачам', en: 'SEQ, average across tasks' }],
    gauge: { kind: 'hearts', value: 6.4, max: 7 },
  },
];

const steps: { id: string; title: Localized; text: Localized }[] = [
  {
    id: 'team',
    title: {
      ru: 'Дизайнили вдвоём, проверяли у сеньора',
      en: 'Designed as a pair, reviewed by a senior designer',
    },
    text: {
      ru: 'Пока один предлагал концепцию, другой искал в ней слабые места, потом менялись ролями. Результат показывали сеньору и, если было нужно, дорабатывали по его правкам.',
      en: 'While one of us proposed a concept, the other looked for its weak spots, then we swapped roles. We showed the result to a senior designer and, when needed, reworked it based on the feedback.',
    },
  },
  {
    id: 'scope',
    title: { ru: 'Выбрали четыре направления', en: 'Picked four focus areas' },
    text: {
      ru: 'Разобрали исходные сценарии и сравнили их в пяти банках. У каждого взяли лучшее и сосредоточились на главной, данных карты, подключении кешбэка и выборе категорий.',
      en: 'We broke down the original flows and compared them across five banks. We took the best from each and focused on the home screen, card details, activating cashback and choosing categories.',
    },
  },
  {
    id: 'prototype',
    title: { ru: 'Не только макеты', en: 'More than mockups' },
    text: {
      ru: 'Завайбкодили прототип для быстрого тестирования: в нём можно пройти сценарии на телефоне — подключить кешбэк, выбрать категории и открыть данные карты.',
      en: 'We vibe-coded a prototype for quick testing: it lets you go through the flows on a phone — activate cashback, choose categories and open card details.',
    },
  },
  {
    id: 'testing',
    title: { ru: 'Видели путь, а не только финал', en: 'We saw the path, not just the finish' },
    text: {
      ru: 'Прототип автоматически фиксировал действия участников: нажатия, прокрутку, переходы между экранами, начало и завершение заданий.',
      en: 'The prototype automatically logged what participants did: taps, scrolling, screen transitions, the start and the end of each task.',
    },
  },
];

const findings: { title: Localized; text: Localized }[] = [
  {
    title: { ru: 'Похожие названия сбивали с толку', en: 'Similar names were confusing' },
    text: {
      ru: 'Кешбэк подключался через «Бонусный счёт», а «Кешбэк и скидки» открывал список партнёров.',
      en: 'Cashback was activated through the “Bonus account”, while “Cashback and discounts” opened a list of partners.',
    },
  },
  {
    title: {
      ru: 'Данные карты искали вне приложения',
      en: 'Card details came from the physical card',
    },
    text: {
      ru: 'Лояльный клиент искал данные своей карты не в приложении: он достал её из кошелька.',
      en: 'A loyal customer didn’t look for their card details in the app: they took the card out of their wallet.',
    },
  },
  {
    title: { ru: 'Не сразу верилось, что это банк', en: 'Hard to believe it was a real bank' },
    text: {
      ru: 'Экраны выглядели собранными по шаблону, и один участник при первом знакомстве засомневался, что перед ним настоящее приложение банка.',
      en: 'The screens looked like they were put together from a template, and at first sight one participant doubted it was a real banking app.',
    },
  },
];

interface Direction {
  id: string;
  title: Localized;
  lead: Localized;
  /** Screens for the callouts (Annotated.astro); its rows then carry their marks. */
