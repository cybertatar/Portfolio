---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  label?: string;
  shape?: 'square' | 'circle';
  tone?: 'raised' | 'inverse';
};

/** Renders <a> when href is set; otherwise a decorative <span> (e.g. the arrow inside a card link). */
const { label, shape = 'square', tone = 'raised', href, ...rest } = Astro.props;
const classes = ['icon-button', { circle: shape === 'circle', inverse: tone === 'inverse' }];
---

{href ? (
  <a href={href} aria-label={label} title={label} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <span class:list={classes} aria-hidden="true">
    <slot />
  </span>
)}

<style>
  .icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--control-h);
    height: var(--control-h);
    background: var(--surface-raised);
    color: var(--text-primary);
    border: 0;
    border-radius: var(--r-control);
    transition: background var(--dur-fast) var(--ease-standard);
  }
  a.icon-button:hover {
    background: var(--surface-active);
    color: var(--text-primary);
  }
  .circle {
    width: var(--arrow-btn);
    height: var(--arrow-btn);
    border-radius: var(--r-circle);
    color: var(--text-secondary);
  }
  .inverse {
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }
</style>
