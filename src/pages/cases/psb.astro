  /* Process — a deck, after the co-author's version: the section holds still for a while,
     each next card slides in from below, the earlier ones step back (up, smaller, darker)
     and peek out over the top. initChapters in case.ts picks the mode: the deck on a desktop
     tall enough for it, cards stacking as the page scrolls otherwise (phone, low laptop),
     and a plain list with reduced motion or no JS. The sidebar contents and the peeking
     edges show where the reader is, so the cards carry no step badges. */
  .chapters {
    container-type: inline-size;
  }
  .cabinet {
    display: flex;
    flex-direction: column;
    gap: var(--space-tile-gap);
  }
  .chapter {
    position: relative;
    scroll-margin-top: 24px;
  }
  /* Text on the left with the card's own padding, the scene bleeds to the card's edge: the
     scene's sunken paper is 1.05:1 against the raised card, so an inset left a frame that
     read as neither a panel nor the card */
  .chapter-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    height: 100%;
    background: var(--surface-raised);
  }
  .chapter-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: var(--space-tile);
  }
  .chapter-media {
    align-self: center;
  }
  .chapter-media :global(.stage) {
    background: none;
  }
  .chapter-dim {
    position: absolute;
    inset: 0;
    background: var(--ink-1);
    opacity: 0;
    pointer-events: none;
  }

  .chapters.is-deck .cabinet {
    position: sticky;
    top: var(--deck-pin);
    display: block;
    height: var(--deck-stage);
  }
  .chapters.is-deck .chapter {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--deck-room);
    z-index: calc(1 + var(--order));
    height: var(--card-h);
    transform-origin: 50% 0;
    will-change: transform;
  }
  /* The card on top casts a soft shadow upward, or its edge is lost on the one below. A
     drop-shadow follows the panel's pixel corners: a box shadow on a layer behind it stayed
     square and left the clipped corners lit by the card underneath */
