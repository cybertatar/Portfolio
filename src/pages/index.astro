---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SideQuests from '../components/SideQuests.astro';
import Button from '../components/ui/Button.astro';
import ContactRow from '../components/ui/ContactRow.astro';
import Footer from '../components/Footer.astro';
import IconButton from '../components/ui/IconButton.astro';
import Media from '../components/ui/Media.astro';
import PixelIcon from '../components/ui/PixelIcon.astro';
import { cases, pokes, profile, ui } from '../content/site';
import { levelOn } from '../scripts/level';
---

<BaseLayout
  title={`${profile.name.ru} — ${profile.role}`}
  enTitle={`${profile.name.en} — ${profile.role}`}
  description={profile.bio.ru}
>
  <div class="root">
    <aside class="aside px-clip" data-stage="0" data-profile>
      <div class="head">
        <div class="portrait">
          <button
            type="button"
            class="portrait-media px-clip"
            aria-label={ui.poke.ru}
            data-en-label={ui.poke.en}
            data-pokes={JSON.stringify(pokes.map((p) => p.ru))}
            data-en-pokes={JSON.stringify(pokes.map((p) => p.en))}
            data-fallen={ui.fallen.ru}
            data-en-fallen={ui.fallen.en}
            data-respawned={ui.respawned.ru}
            data-en-respawned={ui.respawned.en}
            data-poke
          >
            <Media src={profile.portrait} label={ui.portrait} />
          </button>
          <span class="lvl px-clip">
            <span class="lvl-num" data-level>
              {levelOn(profile.birthday)}
            </span>
            <span class="lvl-label">lvl</span>
          </span>
        </div>
        <div class="name">
          <h1 data-en={profile.name.en}>{profile.name.ru}</h1>
          <p class="role">
            <span class="role-label" data-en={ui.class.en}>
              {ui.class.ru}
            </span>
            <span>{profile.role}</span>
          </p>
          {profile.status && (
            <p class="status">
              <span class="status-dot" aria-hidden="true"></span>
              <span data-en={profile.status.en}>{profile.status.ru}</span>
            </p>
          )}
        </div>
      </div>

      <div class="bio">
        <p data-en={profile.bio.en}>{profile.bio.ru}</p>
      </div>

      <div class="zone zone-contacts">
        {profile.contacts.map((c, i) => (
          <ContactRow
            href={c.href}
            value={c.value}
            label={c.label}
            icon={c.icon}
            external={c.external}
            divider={i < profile.contacts.length - 1}
          />
        ))}
      </div>

      <div class="cta">
        <Button href={profile.cvHref} full>
          CV
        </Button>
        <IconButton href={profile.telegramHref} label="Telegram" target="_blank" rel="noopener">
          <PixelIcon name="telegram" />
        </IconButton>
      </div>
    </aside>

    <main class="feed" data-feed>
      <div class="inner">
        <div class="list">
          {cases.map((item) => (
            <article class="slot" data-slot>
              <ProjectCard item={item} />
            </article>
          ))}
          <!-- Side projects close the feed, one card in the cases' shell (review: a strip of
               them above the cases read as unclear) -->
          <section class="slot" data-slot aria-labelledby="side-quests-title">
            <SideQuests />
          </section>
        </div>

        <Footer />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { profile, ui } from '../content/site';
  import { initCardStack, initLevel, initLocked, initPoke, initProfileFit } from '../scripts/home';

  const aside = document.querySelector<HTMLElement>('[data-profile]');
  const feed = document.querySelector<HTMLElement>('[data-feed]');
  if (aside) initProfileFit(aside);
  const level = document.querySelector<HTMLElement>('[data-level]');
  if (level) initLevel(level, profile.birthday, ui.levelUp);
  initLocked([...document.querySelectorAll<HTMLElement>('[data-locked]')]);
  const poke = document.querySelector<HTMLElement>('[data-poke]');
  if (poke) initPoke(poke);
  if (feed) {
    initCardStack(
      feed,
      [...document.querySelectorAll<HTMLElement>('[data-slot]')],
      document.querySelector<HTMLElement>('[data-footer]'),
    );
  }
</script>

<style>
  .root {
    /* Empty space on each side once the screen is wider than the content */
    --side: max(0px, (100vw - var(--layout-content-max)) / 2);
    display: flex;
    align-items: flex-start;
    height: 100vh;
    overflow: hidden;
    background: var(--surface-page);
  }

  /* ---------- Profile aside ---------- */

  .aside {
    /* One clamped basis, not 25% + min/max-width: Safari split the row by the raw 25%
       and pushed the feed past the right edge whenever the 280px minimum kicked in */
    flex: 0 0 clamp(var(--layout-sidebar-min), 25vw, var(--layout-sidebar-max));
    align-self: flex-start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    overflow-x: hidden;
    margin: 24px 0 24px calc(var(--side) + 24px);
    display: flex;
    flex-direction: column;
    padding: 24px;
    /* Empty space above and below the text in a contact row (rows are tall for tapping);
       subtracted so gaps around the contacts read the same as the others */
    --row-inset: calc((var(--control-h) - var(--t-body-sm) * var(--lh-normal)) / 2);
    --cta-gap: 24px;
    background: var(--surface-card);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: none;
    min-width: 0;
  }
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    flex: none;
  }
  .portrait-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
    color: var(--text-tertiary);
  }
  /* px-clip cuts an outer ring off, so the focus ring sits inside */
  .portrait-media:focus-visible {
    outline-offset: -2px;
  }
  /* Burnt down: an empty slot until the respawn */
  .portrait-media:global(.is-down) {
    background: var(--surface-sunken);
  }
  .portrait-media :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Poke: the portrait flinches like a hit unit, with a one-frame flash */
  .portrait-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--surface-raised);
    opacity: 0;
    pointer-events: none;
  }
  .portrait-media:global(.is-hit) {
    animation: flinch 320ms steps(1, end);
  }
  .portrait-media:global(.is-hit)::after {
    animation: flash 320ms steps(1, end);
  }
  @keyframes flinch {
    0% {
      transform: translate(-4px, 2px);
    }
    25% {
      transform: translate(4px, -2px);
    }
    50% {
      transform: translate(-2px, 0);
    }
    75%,
    100% {
      transform: none;
    }
  }
  @keyframes flash {
    0% {
      opacity: 0.5;
    }
    25%,
    100% {
      opacity: 0;
    }
  }

  /* Level badge: sits on the portrait's bottom edge, like a unit frame in an MMO */
  .lvl {
    --px-step: 2px;
    position: absolute;
    left: 12px;
    bottom: -14px;
    display: flex;
    align-items: baseline;
    gap: 5px;
    height: 32px;
    padding: 0 10px;
    background: var(--surface-raised);
    /* The level badge is a piece of game UI: it keeps the pixel face */
    font-family: var(--font-pixel);
    line-height: 32px;
    white-space: nowrap;
    color: var(--text-primary);
  }
  .lvl-num {
    color: var(--text-accent);
    font-size: 26px;
    font-weight: var(--fw-bold);
  }
  /* Fira Mono: in the pixel font a lowercase l is a bare stick */
  .lvl-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
  }

  .name {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    margin-top: clamp(28px, 1.8vw, 34px);
  }
  /* The name plate of the character: pixel, like the level badge next to it. Large, Handjet
     stays crisp; it only blurred at caption sizes */
  h1 {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: calc(var(--t-name) * 1.25);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--text-primary);
  }
  .role {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    font-size: var(--t-button);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
  }
  .role-label {
    font-family: var(--font-label);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-label);
    color: var(--text-tertiary);
  }
  /* Availability, like an "online" status: a blinking pixel dot */
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 2px 0 0;
    font-size: var(--t-caption);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
  }
  .status-dot {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--status-online);
    animation: blink 1.6s steps(1, end) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
  .bio {
    flex: none;
    margin-top: var(--space-zone);
  }
  .bio p {
    margin: 0;
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .zone {
    display: flex;
    flex-direction: column;
    flex: none;
    padding-top: var(--space-zone);
  }
  .zone-contacts {
    gap: 2px;
    margin-top: calc(var(--row-inset) * -1);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    /* Closer to the contacts than the zones are to each other: CV and Telegram are contacts too */
    margin-top: calc(var(--cta-gap) - var(--row-inset));
  }

  /* Height fit, stage 1+: tighter rhythm */
  .aside:not([data-stage='0']) .bio {
    margin-top: 24px;
  }
  .aside:not([data-stage='0']) .zone {
    padding-top: 24px;
  }
  .aside:not([data-stage='0']) {
    --cta-gap: 16px;
  }

  /* Stage 2+: a small square portrait on its own row; the name block keeps the full width
     below it, so the name, class and status never wrap in a narrow sidebar */
  .aside:is([data-stage='2'], [data-stage='3']) .portrait {
    width: 64px;
    height: 64px;
    aspect-ratio: auto;
  }
  /* The square crop zooms in on the face: its centre lands at ~34% / 37% of the frame. */
  .aside:is([data-stage='2'], [data-stage='3']) .portrait-media :global(:is(img, canvas)) {
    transform-origin: 34% 37%;
    transform: translate(16%, 13%) scale(1.8);
  }
  .aside:is([data-stage='2'], [data-stage='3']) .lvl {
    left: calc(100% + 12px);
    bottom: 0;
  }
  .aside:is([data-stage='2'], [data-stage='3']) .name {
    margin-top: 16px;
  }

  /* Stage 3: drop the bio */
  .aside[data-stage='3'] .bio {
    display: none;
  }

  /* ---------- Feed ---------- */

  .feed {
    flex: 1 1 0;
    min-width: 0;
    height: 100vh;
    /* Padding, not margin: the feed scrolls, so its scrollbar and wheel area
       stay at the screen edge */
    padding-right: var(--side);
    overflow-y: auto;
    overflow-x: hidden;
  }
  .inner {
    width: 100%;
    max-width: var(--layout-feed-max);
    margin: 0 auto;
    padding: 24px 24px 0;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--layout-feed-gap);
  }
  .slot {
    position: sticky;
    top: 24px;
    will-change: transform;
  }
  /* ---------- Mobile / tablet portrait ---------- */

  @media (max-width: 960px) {
    .root {
      display: block;
      height: auto;
      overflow-x: clip;
      overflow-y: visible;
    }
    .aside {
      width: calc(100% - 32px);
      max-width: 640px;
      min-width: 0;
      max-height: none;
      overflow: visible;
      margin: 16px auto 0;
      /* Inner padding no larger than the 16px screen margin and gaps */
      padding: 16px;
    }
    .feed {
      height: auto;
      padding-right: 0;
      overflow: visible;
    }
    .inner {
      max-width: 672px;
      padding: 16px 16px 0;
    }
    .list {
      gap: 16px;
    }
    .slot {
      top: 16px;
    }
  }
</style>
