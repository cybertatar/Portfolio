---
import { en, ru, sideQuests, ui } from '../content/site';
import Button from './ui/Button.astro';
import IconButton from './ui/IconButton.astro';
import PixelIcon from './ui/PixelIcon.astro';
import { withBase } from '../scripts/url';

/**
 * Small side projects as the last card of the feed, in the same shell as the cases: where a
 * case has its cover, a quest log right on the card, then the title and a line under it:
 * a row per project (icon, name and description, links out), keylines between them, like the
 * list of changes on the case page. A new project is one more row. Replaces a carousel strip
 * above the cases that the review found unclear (and its fades fell out of the lo-fi look).
 */
---

<div class="card px-clip">
  <ul class="log">
    {sideQuests.map((q) => {
      const name = { ru: ru(q.title), en: en(q.title) ?? ru(q.title) };
      const label = (what: { ru: string; en: string }) => ({
        label: `${what.ru}: ${name.ru}`,
        'data-en-label': `${what.en}: ${name.en}`,
        'data-en-title': `${what.en}: ${name.en}`,
      });
      return (
        <li class="quest">
          <img class="icon" src={withBase(q.icon)} alt="" width="48" height="48" loading="lazy" />
          <div class="text">
            <h3 class="name" data-en={en(q.title)}>
              {name.ru}
            </h3>
            <p class="about" data-en={q.description.en}>
              {q.description.ru}
            </p>
          </div>
          <div class="links">
            {/* The project itself comes first, when there is one to open */}
            {q.app && (
              <Button
                href={q.app}
                tone="raised"
                target="_blank"
                rel="noopener"
                aria-label={`${ui.bot.ru}: ${name.ru}`}
                data-en-label={`${ui.bot.en}: ${name.en}`}
              >
                <PixelIcon name="telegram" size={18} />
                <span data-en={ui.bot.en}>{ui.bot.ru}</span>
              </Button>
            )}
            <IconButton href={q.github} target="_blank" rel="noopener" {...label(ui.repo)}>
              <PixelIcon name="github" size={18} />
            </IconButton>
            {q.instagram && (
              <IconButton href={q.instagram} target="_blank" rel="noopener" {...label(ui.post)}>
                <PixelIcon name="instagram" size={18} />
              </IconButton>
            )}
          </div>
        </li>
      );
    })}
  </ul>
  <div class="body">
    <h2 class="title" id="side-quests-title" data-en={ui.sideQuests.en}>
      {ui.sideQuests.ru}
    </h2>
    <p class="description" data-en={ui.sideQuestsLead.en}>
      {ui.sideQuestsLead.ru}
    </p>
  </div>
</div>

<style>
  /* The case card's shell (ProjectCard.astro): padding, gap, title and line */
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background: var(--surface-card);
  }
  /* Right on the card: on the sunken panel a case has for its cover, the light buttons
     nearly matched it (#e8e1d2 on #e3dccc) and the log read muddy (owner) */
  .log {
    container-type: inline-size;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quest {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 0;
  }
  /* A quiet hairline: the 2px keyline of the case's list hit the eye on the light card (owner) */
  .quest + .quest {
    border-top: var(--border-width-hair) solid var(--border-subtle);
  }
  .icon {
    display: block;
    width: 48px;
    height: 48px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  /* A list entry, not a heading of the page: the body sans */
  .name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-button);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  .about {
    margin: 0;
    font-size: var(--t-caption);
    line-height: var(--lh-snug);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  /* Links out to the project, not controls of the page: smaller than the page's buttons,
     on phones too (32px is still above the 24px minimum target) */
  .links {
    --control-h: 32px;
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }
  .links > :global(.button) {
    gap: 6px;
    padding: 0 12px;
    font-size: var(--t-button);
  }
  /* A little more room between targets for a finger */
  @media (pointer: coarse) {
    .links {
      gap: 8px;
    }
  }
  /* Narrow: the links go under the description */
  @container (max-width: 520px) {
    .quest {
      grid-template-columns: 48px minmax(0, 1fr);
      align-items: start;
    }
    .links {
      grid-column: 2;
      justify-content: flex-start;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 0.6vw, 14px);
  }
  .title {
    margin: 0;
    font-size: var(--t-card-title);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tighter);
    color: var(--text-primary);
  }
  .description {
    margin: 0;
    font-size: var(--t-card-sub);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }

  /* Mobile: inner padding no larger than the 16px gaps around the card */
  @media (max-width: 960px) {
    .card {
      gap: 16px;
      padding: 16px;
    }
  }
</style>
