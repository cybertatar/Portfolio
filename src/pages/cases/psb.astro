                <h3 class="psr-title">Проблема</h3>
                <p class="body">{d.problem}</p>
              </div>
              <div>
                <h3 class="psr-title">Решение</h3>
                <p class="body">{d.solution}</p>
              </div>
              <div>
                <h3 class="psr-title">Результат</h3>
                <p class="body">{d.result}</p>
              </div>
            </div>
          </section>
        ))}

        <!-- ---------- UI kit ---------- -->
        <section id="kit" class="sheet px-clip">
          <p class="eyebrow">Система</p>
          <h2 class="h2">Спеки и UI-кит</h2>
          <p class="lead">
            Хоть это и концепт, на каждый компонент я написал спецификацию и разложил компоненты
            так, чтобы с ними было удобно работать.
          </p>
          <div class="slot wide-slot px-clip">
            <Media label={{ ru: 'Место для UI-кита', en: 'UI kit goes here' }} />
          </div>
        </section>

        <!-- ---------- Testing ---------- -->
        <section id="testing" class="sheet px-clip">
          <p class="eyebrow">Проверка</p>
          <h2 class="h2">Тестирование с 30 клиентами</h2>
          <p class="lead">
            На телефонах участники проходили три задачи в рабочем прототипе. Мы смотрели на
            достижение цели, первое действие и субъективную лёгкость.
          </p>
          <div class="table-wrap px-clip">
            <table>
              <thead>
                <tr>
                  <th scope="col">Сценарий</th>
                  <th scope="col">Завершили</th>
                  <th scope="col">First click success</th>
                  <th scope="col">SEQ</th>
                </tr>
              </thead>
              <tbody>
                {tests.map((t) => (
                  <tr>
                    <th scope="row">{t.task}</th>
                    <td>{t.done}</td>
                    <td>{t.fcs}</td>
                    <td>{t.seq}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">
            Средняя оценка лёгкости — 6,4 из 7. Для сравнения пять клиентов банка прошли подключение
            кешбэка и путь к данным карты на кликабельной копии исходных экранов. Время «было» —
            медиана выполнивших.
          </p>
        </section>

        <!-- ---------- Review ---------- -->
        <section id="review" class="sheet px-clip">
          <p class="eyebrow">Ревью</p>
          <h2 class="h2">Что сказал сеньор</h2>
          <div class="wide">
            <CaseVideo
              src="assets/cases/psb/review.ru.mp4"
              poster="assets/cases/psb/review-poster.ru.webp"
              enSrc="assets/cases/psb/review.en.mp4"
              enPoster="assets/cases/psb/review-poster.en.webp"
              ratio="16 / 9"
              label="Ревью кейса от сеньор-дизайнера"
              enLabel="Case review by a senior designer"
            />
          </div>
        </section>

        <!-- ---------- Outcome ---------- -->
        <section id="outcome" class="sheet px-clip">
          <p class="eyebrow">Выводы</p>
          <h2 class="h2">Что я вынес из этого концепта</h2>
          <p class="lead">
            Иногда мало убрать барьеры и ускорить задачу. Нужно ещё сопровождать человека на всём
            пути, помогать ему выстроить верные ментальные модели и мягко балансировать между
            интересами бизнеса и пользователя, чтобы в продукт хотелось возвращаться.
          </p>
          <h3 class="h3 sub-title">Что бы я ещё протестировал</h3>
          <div class="trio">
            {next.map((n) => (
              <div class="tile px-clip">
