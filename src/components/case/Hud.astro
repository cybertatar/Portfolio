---
import { heartPaths } from '../../content/pixel-heart';
import { en, ru, type Localized, type Text } from '../../content/site';

/**
 * Results as a row of game HUD stats, after Zelda. Every stat has the same build: a title, the
 * big number, its gauge right under it and the context below, so the row reads as one rhythm
 * and each gauge stays next to its number (proximity) while the gauges still line up.
 * Gauges: time is a bar whose light track is the old time and whose fill is the new one (it
 * shrinks from the old length on view); first click success is a mana bar; the ease score is
 * a row of heart containers. They play once when scrolled into view (initHud in
 * scripts/case.ts); without JS or with reduced motion they just show the end state.
 */
export type HudGauge =
  | { kind: 'time'; from: number; to: number }
  | { kind: 'mana'; value: number }
  | { kind: 'hearts'; value: number; max: number };

export interface HudStat {
  label: Text;
  /** The big number, and a smaller unit after it */
  value: Text;
  unit?: Localized;
  /** Context lines under the number */
  notes: Localized[];
  gauge: HudGauge;
}

interface Props {
  stats: HudStat[];
  note?: Localized;
}

const { stats, note } = Astro.props;
let uid = 0;

// Whole pixels of the 9-pixel heart, like Zelda's partial hearts
const heartFill = (value: number, i: number) => Math.round(Math.max(0, Math.min(1, value - i)) * 9);
---

<div class="hud-wrap">
  <ul class="hud" data-hud>
    {stats.map((s) => (
      <li class="stat">
        <span class="label" data-en={en(s.label)}>
          {ru(s.label)}
        </span>
        <span class="value">
          <span data-en={en(s.value)}>{ru(s.value)}</span>
          {s.unit && (
            <span class="unit" data-en={s.unit.en}>
              {s.unit.ru}
            </span>
          )}
        </span>

        <span class="gauge" aria-hidden="true">
          {s.gauge.kind === 'time' && (
            <span class="track px-clip">
              <span class="fill time" style={`--to: ${(s.gauge.to / s.gauge.from) * 100}%`} />
            </span>
          )}
          {s.gauge.kind === 'mana' && (
            <span class="track px-clip">
              <span class="fill mana" style={`--to: ${s.gauge.value}%`} />
            </span>
          )}
          {s.gauge.kind === 'hearts' && (
            <span class="hearts">
              {Array.from({ length: s.gauge.max }, (_, i) => {
                const px = heartFill(s.gauge.kind === 'hearts' ? s.gauge.value : 0, i);
                const id = `hud-heart-${uid++}`;
                return (
                  <svg
                    class="heart"
                    style={`--i: ${i}`}
                    viewBox="0 0 9 8"
                    shape-rendering="crispEdges"
                    focusable="false"
                  >
                    <clipPath id={id}>
                      <rect width={px} height="8" />
                    </clipPath>
                    {heartPaths.map((p) => (
                      <path class={`e-${p.c}`} d={p.d} />
                    ))}
                    {px > 0 && (
                      <g class="heart-fill" clip-path={`url(#${id})`}>
                        {heartPaths.map((p) => (
                          <path class={`f-${p.c}`} d={p.d} />
                        ))}
                      </g>
                    )}
                  </svg>
                );
              })}
            </span>
          )}
        </span>
        {s.notes.map((n) => (
          <span class="note-line" data-en={n.en}>
            {n.ru}
          </span>
        ))}
      </li>
    ))}
  </ul>
  {note && (
    <p class="note" data-en={note.en}>
      {note.ru}
    </p>
  )}
</div>

<style>
  /* The note is about the whole row, so it sits at least a row's distance away */
  .hud-wrap {
    display: flex;
    flex-direction: column;
    gap: 40px;
    container-type: inline-size;
  }
  /* One row of four on the sheet itself, no panels: like Zelda's HUD over the world */
  .hud {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* Columns well apart from each other, more than any gap inside a stat */
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @container (max-width: 720px) {
    .hud {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .label {
    margin-bottom: 10px;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  /* The same sans as the text, which has no slashed zero (Handjet's made 105 read as 185) */
  .value {
    font-size: calc(var(--t-stat) * 1.15);
    font-weight: var(--fw-semibold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .unit {
    margin-left: 0.25em;
    font-size: 0.5em;
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  .note-line {
    font-size: var(--t-caption);
    line-height: var(--lh-normal);
    color: var(--text-tertiary);
  }
  .gauge {
    display: block;
    margin: 12px 0 10px;
  }

  /* Bars: the track is a light step of the same sky, the fill the stronger one */
  .track {
    --px-step: 3px;
    display: flex;
    height: 14px;
    background: color-mix(in srgb, var(--sky-300) 35%, var(--surface-card));
  }
  .fill {
    display: block;
    width: var(--to);
  }
  .fill.time {
    background: var(--sky-400);
  }
  .fill.mana {
    background: repeating-linear-gradient(90deg, var(--sky-400) 0 10px, var(--sky-500) 10px 12px);
  }

  /* Ease score: heart containers, the one playful colour here */
  .hearts {
    display: flex;
    gap: 3px;
  }
  .heart {
    flex: 0 1 22px;
    min-width: 0;
    aspect-ratio: 9 / 8;
  }
  .e-R {
    fill: var(--line-3);
  }
  .e-r,
  .e-q {
    fill: var(--paper-4);
  }
  .f-R {
    fill: var(--heart-edge);
  }
  .f-r {
    fill: var(--heart-fill);
  }
  .f-q {
    fill: var(--paper-2);
  }

  .note {
    margin: 0;
    font-size: var(--t-caption);
    color: var(--text-tertiary);
  }

  /* Play once on view. Armed only by the script, so without JS the end state shows. */
  @media (prefers-reduced-motion: no-preference) {
    .hud[data-armed] .fill.time {
      width: 100%;
    }
    .hud[data-armed] .fill.mana {
      width: 0;
    }
    .hud[data-armed] .heart-fill {
      opacity: 0;
    }
    .hud.is-on .fill.time {
      width: var(--to);
      transition: width 700ms steps(10) 300ms;
    }
    .hud.is-on .fill.mana {
      width: var(--to);
      transition: width 800ms steps(12) 300ms;
    }
    .hud.is-on .heart-fill {
      opacity: 1;
      transition: opacity 0s calc(300ms + var(--i) * 110ms);
    }
  }
</style>
