---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  full?: boolean;
  /** `raised` is the light secondary button, like the square icon buttons. */
  tone?: 'inverse' | 'raised';
};
const { href, full = false, tone = 'inverse', ...rest } = Astro.props;
---

<a href={href} class:list={['button', 'px-clip', { full, raised: tone === 'raised' }]} {...rest}>
  <slot />
</a>

<style>
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    min-width: 0;
    height: var(--control-h);
    padding: 0 20px;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border: 0;
    font-family: var(--font-pixel);
    font-size: calc(var(--t-button) * 1.3);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .button:hover {
    background: var(--surface-inverse-hover);
    color: var(--text-inverse);
  }
  .raised {
    background: var(--surface-raised);
    color: var(--text-primary);
  }
  .raised:hover {
    background: var(--surface-active);
    color: var(--text-primary);
  }
  .full {
    flex: 1 1 auto;
  }
</style>
