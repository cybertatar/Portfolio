---
import { type Localized, type Text } from '../../content/site';
import PixelIcon from '../ui/PixelIcon.astro';
import Hud, { type HudStat } from './Hud.astro';

export interface ResultStat {
  value: Text;
  unit?: Localized;
  note: Localized;
}

interface Props {
  stats: ResultStat[];
}

/**
 * The result of the test for one solution: its own card under the stage, not the end of the
 * list of changes (the owner: it's a different thing, what people did, not what we changed).
 * The same build as the overview's results, a trophy and HUD stats: a percentage gets a bar,
 * an ease score out of 7 gets hearts, and they fill once on view (initHud).
 */
const { stats } = Astro.props;
// The English spelling has the decimal point (6.7, not 6,7)
const num = (v: Text) => parseFloat(typeof v === 'string' ? v : v.en);
const hud: HudStat[] = stats.map((s) => ({
  value: s.value,
  unit: s.unit,
  notes: [s.note],
  gauge: s.unit
    ? { kind: 'hearts', value: num(s.value), max: 7 }
    : { kind: 'mana', value: num(s.value) },
}));
---

<section class="test px-clip">
  <div class="head">
    <span class="icon px-clip">
      <PixelIcon name="trophy" />
    </span>
    <span class="titles">
      <h3 class="title" data-en="Test result">
        Итог теста
      </h3>
      <span class="sub" data-en="Usability test with 30 of the bank’s customers">
        Юзабилити-тест с 30 клиентами банка
      </span>
    </span>
  </div>
  <Hud stats={hud} columns={stats.length} />
</section>

<style>
  /* A card of its own on the sheet, a frame's gap under the stage: the heading on top, the
     stats under it. The same raised paper and pixel corners as the overview's cards */
  .test {
    --px-step: 4px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: var(--space-tile-gap);
    padding: var(--space-tile);
    background: var(--surface-raised);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    background: var(--surface-card);
    color: var(--text-accent);
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-h3);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text-primary);
  }
  .sub {
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--text-tertiary);
  }
</style>
