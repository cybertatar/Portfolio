---
import Sprite from './scenes/Sprite.astro';
import type { MascotSpriteName } from '../../content/mascots';

/**
 * What we did, as a guild quest board: four completed quests, all in view, laid out on the sheet
 * itself (no fills). Only the solution: the problems are told in the intro and the numbers live
 * in the results HUD, so nothing is said twice. Each title links to its full write-up.
 */
export interface Quest {
  /** Section id of the full write-up further down the page */
  id: string;
  title: string;
  sprite: MascotSpriteName;
  solution: string;
}

interface Props {
  quests: Quest[];
}

const { quests } = Astro.props;
---

<ul class="board">
  {quests.map((q) => (
    <li class="quest">
      <span class="slot px-clip" aria-hidden="true">
        <Sprite name={q.sprite} />
      </span>
      <div class="text">
        <a class="title" href={`#${q.id}`}>
          {q.title}
        </a>
        <p class="solution">{q.solution}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px var(--space-split);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 640px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
  .quest {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .slot {
    --px-step: 3px;
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    background: var(--surface-raised);
  }
  .slot :global(svg) {
    width: 24px;
    height: auto;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }
  .title {
    font-size: var(--t-lead);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
    text-decoration: none;
  }
  .title:hover {
    color: var(--text-accent);
  }
  .solution {
    margin: 0;
    font-size: var(--t-body);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }
</style>
