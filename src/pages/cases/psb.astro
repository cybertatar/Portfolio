<script>
  import {
    initCaseMenu,
    initCompare,
    initChapters,
    initHud,
    initQuestDeck,
    initRace,
    initScrollSpy,
  } from '../../scripts/case';

  initScrollSpy(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')],
    document.querySelector<HTMLElement>('[data-case-current]'),
  );
  const bar = document.querySelector<HTMLElement>('[data-case-bar]');
  if (bar) initCaseMenu(bar);
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(initCompare);
  document.querySelectorAll<HTMLElement>('[data-chapters]').forEach(initChapters);
  document.querySelectorAll<HTMLElement>('[data-hud]').forEach(initHud);
  document.querySelectorAll<HTMLElement>('[data-quest-deck]').forEach(initQuestDeck);
  document.querySelectorAll<HTMLElement>('[data-race]').forEach(initRace);
</script>

