---
import type { PixelIconName } from '../../content/pixel-icons';
import PixelIcon from './PixelIcon.astro';

interface Props {
  href: string;
  value: string;
  label: string;
  divider?: boolean;
  external?: boolean;
  /** When set, the icon stands in for the visible label. */
  icon?: PixelIconName;
}
const { href, value, label, divider = true, external = false, icon } = Astro.props;
---

<a
  href={href}
  class:list={['contact-row', { divider }]}
  aria-label={icon ? `${label}: ${value}` : undefined}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icon && <PixelIcon name={icon} />}
  <span class="value">{value}</span>
  {!icon && <span class="label">{label}</span>}
</a>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--control-h);
    font-size: var(--t-body-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .contact-row:hover {
    color: var(--text-primary);
  }
  .divider {
    border-bottom: var(--border-width-hair) solid var(--border-subtle);
  }
  .value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .label {
    flex: none;
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
</style>
