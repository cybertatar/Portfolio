---
import { en, ru, type Localized, type Text } from '../../content/site';

export interface VersusRow {
  label: Text;
  before: Localized;
  after: Localized;
}
export interface VersusStat {
  value: Text;
  unit?: Localized;
  note: Localized;
}

interface Props {
  rows: VersusRow[];
  stats: VersusStat[];
}

/**
 * What changed, fact by fact, then the result in a few numbers. Each change reads top to bottom
 * on one left edge: the subject, what it is now, and under it, quieter, what it was. A table with
 * a right-aligned "было", a centred subject and a left-aligned "стало" made the eye zigzag across
 * every row (NN/g, zigzag layouts; grids: align to column edges). Short columns of a modular grid
 * instead of long lines, so it reads as a few facts, not a sheet of text: three across, two when
 * there are four (2 + 2 rather than 3 + 1), one on a narrow sheet. The steps and time are not
 * repeated here, the race above shows them.
 */
const { rows, stats } = Astro.props;
---

<div class="versus">
  <ul
    class="changes"
    style={`--cols: ${rows.length === 4 ? 2 : 3}`}
    aria-label="Было и стало"
    data-en-label="Before and after"
  >
    {rows.map((r) => (
      <li class="change">
        <span class="label" data-en={en(r.label)}>
          {ru(r.label)}
        </span>
        <p class="after">
          <span class="sr" data-en="After: ">
            Стало:{' '}
          </span>
          <span data-en={r.after.en}>{r.after.ru}</span>
        </p>
        <p class="before" data-en={`Before: ${r.before.en}`}>
          Было: {r.before.ru}
        </p>
      </li>
    ))}
  </ul>
  <!-- The result is its own card: the boundary groups the numbers (NN/g, common region) -->
  <div class="result px-clip">
    <p class="result-title" data-en="Test result">
      Итог теста
    </p>
    <ul class="stats" style={`--n: ${stats.length}`}>
      {stats.map((s) => (
        <li class="stat">
          <span class="value">
            <span data-en={en(s.value)}>{ru(s.value)}</span>
            {s.unit && (
              <span class="unit" data-en={s.unit.en}>
                {s.unit.ru}
              </span>
            )}
          </span>
          <span class="note" data-en={s.note.en}>
            {s.note.ru}
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .versus {
    display: flex;
    flex-direction: column;
    gap: 40px;
    container-type: inline-size;
  }
  .changes {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: 40px;
    row-gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The keyline on top ties the subject to its column; inside an item the lines sit closer
     (about 12 with the leading) than the items to each other (32 + 12) */
  .change {
    /* Holds the hidden "Стало:" */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding-top: 14px;
    border-top: var(--border-width-keyline) solid var(--border-default);
    text-wrap: pretty;
  }
  .label {
    font-family: var(--font-pixel);
    font-size: var(--t-pixel-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .after,
  .before {
    margin: 0;
  }
  /* Often two lines: body leading, not the snug one of a single-line title */
  .after {
    font-size: var(--t-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-normal);
    color: var(--text-primary);
  }
  .before {
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The result card, built like the quest and HUD cards: title, then the numbers */
  .result {
    --px-step: 3px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: var(--space-tile);
    background: var(--surface-raised);
  }
  .result-title {
    margin: 0;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .value {
    font-size: var(--t-stat);
    font-weight: var(--fw-semibold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .unit {
    margin-left: 0.25em;
    font-size: 0.5em;
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  /* The same secondary size as "Было: …" above, one style for the quieter text in the block */
  .note {
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  @container (max-width: 720px) {
    .changes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }
  @container (max-width: 560px) {
    .changes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }
    /* Two numbers stay side by side, a third goes under them */
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
      gap: 24px;
    }
  }
</style>
