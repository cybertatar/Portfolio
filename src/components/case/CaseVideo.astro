---
import { withBase } from '../../scripts/url';

interface Props {
  src: string;
  poster: string;
  /** Width / height, e.g. "4 / 3". */
  ratio: string;
  label: string;
  /** loop: silent, plays while on screen. player: has sound, plays on demand. */
  mode?: 'loop' | 'player';
}

const { src, poster, ratio, label, mode = 'loop' } = Astro.props;
const loop = mode === 'loop';
---

<div class="video px-clip" style={{ aspectRatio: ratio }}>
  {loop ? (
    <video
      src={withBase(src)}
      poster={withBase(poster)}
      muted
      loop
      playsinline
      preload="none"
      aria-label={label}
      data-loop-video
    />
  ) : (
    <video
      src={withBase(src)}
      poster={withBase(poster)}
      controls
      playsinline
      preload="none"
      aria-label={label}
    />
  )}
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--surface-inverse);
  }
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
