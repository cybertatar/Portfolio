---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import CaseVideo from '../../components/case/CaseVideo.astro';
import Compare from '../../components/case/Compare.astro';
import Phone from '../../components/case/Phone.astro';
import BenchScene from '../../components/case/scenes/BenchScene.astro';
import TeamScene from '../../components/case/scenes/TeamScene.astro';
import TestingScene from '../../components/case/scenes/TestingScene.astro';
import IconButton from '../../components/ui/IconButton.astro';
import Media from '../../components/ui/Media.astro';
import PixelIcon from '../../components/ui/PixelIcon.astro';
import { withBase } from '../../scripts/url';

/** Contents: the sidebar on desktop, the drop-down list on mobile. `sub` items are indented. */
const toc = [
  { id: 'overview', title: 'Обзор' },
  { id: 'screens', title: 'Финальные экраны' },
  { id: 'process', title: 'Как мы работали' },
  { id: 'interviews', title: 'Интервью' },
  { id: 'home', title: 'Главная', group: 'Решения' },
  { id: 'card-data', title: 'Данные карты', sub: true },
  { id: 'cashback', title: 'Подключение кешбэка', sub: true },
  { id: 'categories', title: 'Кешбэк после подключения', sub: true },
  { id: 'kit', title: 'UI-кит' },
  { id: 'testing', title: 'Тестирование' },
  { id: 'outcome', title: 'Выводы' },
];

const screens = [
  { src: 'assets/cases/psb/main.webp', caption: 'Главная' },
  { src: 'assets/cases/psb/account.webp', caption: 'Счёт и его карты' },
  { src: 'assets/cases/psb/cb-off.webp', caption: 'Кешбэк до подключения' },
  { src: 'assets/cases/psb/cb-connect.webp', caption: 'Выбор категорий' },
  { src: 'assets/cases/psb/success.webp', caption: 'Кешбэк подключён' },
  { src: 'assets/cases/psb/cb-on.webp', caption: 'Кешбэк после подключения' },
];

const stats = [
  { label: 'Шаги подключения кешбэка', from: '12', to: '5' },
  { label: 'Время подключения кешбэка', from: '105', to: '23', unit: 'с' },
  { label: 'Шаги к данным карты', from: '7', to: '4' },
  { label: 'Время до данных карты', from: '42', to: '17', unit: 'с' },
  { label: 'First click success', to: '89%' },
  { label: 'SEQ, оценка лёгкости', to: '6,4', unit: 'из 7' },
];

const steps = [
  {
    title: 'Дизайнили вдвоём, проверяли у сеньора',
    text: 'Пока один предлагал концепцию, другой искал в ней слабые места, потом менялись ролями. Результат показывали сеньору и, если было нужно, дорабатывали по его правкам.',
    scene: 'team',
  },
  {
    title: 'Выбрали четыре направления',
    text: 'Разобрали исходные сценарии и сравнили их в пяти банках. У каждого взяли лучшее и сосредоточились на главной, данных карты, подключении кешбэка и выборе категорий.',
    scene: 'bench',
  },
  {
    title: 'Не только макеты',
    text: 'Завайбкодили прототип для быстрого тестирования: в нём можно пройти сценарии на телефоне — подключить кешбэк, выбрать категории и открыть данные карты.',
  },
  {
    title: 'Видели путь, а не только финал',
    text: 'Прототип автоматически фиксировал действия участников: нажатия, прокрутку, переходы между экранами, начало и завершение заданий.',
    scene: 'testing',
  },
];

const findings = [
  {
    title: 'Похожие названия сбивали с толку',
    text: 'Кешбэк подключался через «Бонусный счёт», а «Кешбэк и скидки» открывал список партнёров.',
  },
  {
    title: 'Данные карты искали вне приложения',
    text: 'Лояльный клиент искал данные своей карты не в приложении: он достал её из кошелька.',
  },
  {
    title: 'Не сразу верилось, что это банк',
    text: 'Экраны выглядели собранными по шаблону, и один участник при первом знакомстве засомневался, что перед ним настоящее приложение банка.',
  },
];

const directions = [
  {
    id: 'home',
    title: 'Главная страница',
    lead: 'Повседневные задачи и предложения банка должны быть заметны одновременно, но не конкурировать между собой.',
    compare: { before: 'assets/cases/psb/main-before.webp', after: 'assets/cases/psb/main.webp' },
    problem:
      'Повседневные операции, промо и другие продукты имели близкий визуальный вес. Историю и кешбэк было трудно найти.',
    solution:
      'Сгруппировали баланс, действия и историю; показали карты внутри счетов. Сначала на главной был ещё и отдельный блок кешбэка, но вместе с вкладкой и бейджем получалось три входа. Блок убрали и оставили бейдж, чтобы проверить, заметят ли его.',
    result:
      'Кешбэк нашли все 30 участников: 63% — через «Выгоду», 37% — через бейдж у суммы, так что второй вход не остался незамеченным.',
  },
  {
    id: 'card-data',
    title: 'Данные карты',
    lead: 'Посмотреть и скопировать данные карты должно быть простым и понятным действием сразу после входа в приложение.',
    after: ['assets/cases/psb/account.webp'],
    problem:
      'Данные лежали на третьей вкладке и защищались пушами и кодами: CVV открывался только по коду из СМС, даже после входа по биометрии. Один участник из-за сложного поиска доставал физическую карту.',
    solution:
      'Показали связь счёта и карты и собрали просмотр и копирование на одном экране. Код из СМС перед показом CVV убрали: клиент уже вошёл по ПИН-коду или биометрии, и во многих банках этого достаточно, пока активен токен. Короткий toast подтверждает, что данные скопированы.',
    result:
      'Большинство нашли данные сразу: first click success — 83%. Но клиентам, у которых ПСБ — единственный банк, было непривычно видеть карты внутри счёта, а переворот карты оказался не самым явным способом показать данные. Это отразилось на SEQ — 6,0 из 7.',
  },
  {
    id: 'cashback',
    title: 'Подключение кешбэка',
    lead: 'Выгоду было видно на странице предложения, но путь к подключению проходил через почту, браузер и повторные подтверждения.',
    after: [
      'assets/cases/psb/cb-off.webp',
      'assets/cases/psb/cb-connect.webp',
      'assets/cases/psb/success.webp',
    ],
    problem:
      'Путь был длинным и заканчивался тупиком: из-за ошибки подключённый кешбэк не появлялся, пока не обновишь экран или не перезайдёшь в приложение. Вероятно, это снижало долю клиентов, которые начинали им пользоваться.',
    solution:
      'Логику программы не трогали, убрали только лишние танцы: почту, браузер, повторный ввод данных и экраны согласий. Осталась одна кнопка «Подключить кешбэк» рядом с условиями. Подключение объединили с выбором категорий, поэтому кешбэк начинает работать сразу.',
    result:
      'Все участники подключили кешбэк, и большинство сразу начали с правильного действия: first click success — 83%. Обычно уходило около 23 секунд. Без ошибок прошли 63%: по пути часто отвлекались на условия и плитки предложений, это стоит проработать дальше. SEQ — 6,5 из 7.',
  },
  {
    id: 'categories',
    title: 'Кешбэк после подключения',
    lead: 'Кешбэк должен приносить выгоду каждый месяц, а не только после первого подключения.',
    after: ['assets/cases/psb/cb-on.webp'],
    problem:
      'Категории нужно было выбирать каждый месяц, но приложение об этом не напоминало, а кнопка выбора на экране кешбэка была не очень заметной.',
    solution:
      'Категории на следующий месяц можно выбрать заранее, чтобы не вспоминать о кешбэке в начале месяца. Выбор можно изменить до начала периода.',
    result:
      'Выбор на следующий месяц устроен так же, как при первом подключении, поэтому разбираться заново не пришлось: first click success вырос до 100%. На выбор уходило около 14 секунд, без ошибок справились 90%, а SEQ 6,7 из 7 оказался самым высоким в тесте.',
  },
];

const tests = [
  { task: 'Подключить кешбэк', done: '30/30', fcs: '83%', seq: '6,5/7' },
  { task: 'Выбрать категории', done: '30/30', fcs: '100%', seq: '6,7/7' },
  { task: 'Скопировать данные карты', done: '30/30', fcs: '83%', seq: '6,0/7' },
];

const next = [
  {
    title: 'Вход в кешбэк',
    text: 'В тесте кешбэк искали по заданию, а в жизни на него натыкаются случайно. Стоит проверить, заметят ли его самостоятельно, и, если подключение в приоритете, попробовать на главной баннер с выгодой.',
  },
  {
    title: 'Данные карты',
    text: 'Сравнить переворот карты с блоком данных под ней. Участникам старшей возрастной группы переворот, похоже, давался сложнее, особенно тем, у кого ПСБ — единственный банк.',
  },
  {
    title: 'Подключение кешбэка',
    text: 'Часть участников по пути первым делом цепляла плитки предложений. Можно ослабить их визуальный вес и проверить это в следующих итерациях.',
  },
];

const title = 'PSB-Bank Redesign concept';
const home = withBase('/');
---

<BaseLayout
  title={`${title} — Даниил Тынчеров`}
  description="Переосмысление ключевых сценариев в мобильном приложении банка"
>
  <div class="root">
    <!-- Desktop: the sidebar keeps its place from the home page and turns into the contents -->
    <aside class="aside px-clip">
      <a class="back" href={home}>
        <span class="back-icon">
          <PixelIcon name="arrow" />
        </span>
        <span>Все кейсы</span>
      </a>
      <div class="case-id">
        <div class="thumb px-clip">
          <img src={withBase('assets/cases/psb-cover.webp')} alt="" />
        </div>
        <p class="case-name">{title}</p>
      </div>
      <nav class="toc" aria-label="Разделы кейса">
        <ol>
          {toc.map((item) => (
            <li class:list={{ sub: item.sub, grouped: item.group }}>
              {item.group && <span class="toc-group">{item.group}</span>}
              <a href={`#${item.id}`} data-toc>
                {item.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <!-- Mobile: a bar pinned to the top — back home, and the current section that opens the list -->
    <header class="bar" data-case-bar>
      <div class="bar-row px-clip">
        <IconButton href={home} label="Все кейсы">
          <span class="back-icon">
            <PixelIcon name="arrow" />
          </span>
        </IconButton>
        <button
          class="toggle"
          type="button"
          aria-expanded="false"
          aria-controls="case-menu"
          data-case-toggle
        >
          <span class="toggle-text">
            <span class="toggle-label">Раздел</span>
            <span class="toggle-current" data-case-current>
              Обзор
            </span>
          </span>
          <span class="toggle-icon">
            <PixelIcon name="chevron" />
          </span>
        </button>
      </div>
      <nav class="menu px-clip" id="case-menu" aria-label="Разделы кейса" hidden data-case-menu>
        <ol>
          {toc.map((item) => (
            <li class:list={{ sub: item.sub, grouped: item.group }}>
              {item.group && <span class="toc-group">{item.group}</span>}
              <a href={`#${item.id}`} data-toc data-title={item.title}>
                {item.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <main class="main">
      <div class="sheets">
        <!-- ---------- Overview ---------- -->
        <section id="overview" class="sheet px-clip">
          <p class="eyebrow">ПСБ Mobile — концепт-редизайн</p>
          <h1 class="title">
            Упростил ежедневные действия, которые в приложении ощущались как поход в отделение
          </h1>
          <div class="hero px-clip">
            <img src={withBase('assets/cases/psb-cover.webp')} alt="Экраны нового ПСБ Mobile" />
          </div>

          <div class="intro">
            <div class="prose">
              <p>
                Я клиент ПСБ пять лет, но о кешбэке с неплохими процентами{' '}
                <strong>узнал не из приложения, а от друга</strong>. Он бросил подключение на
                середине. Мне же кешбэк не помешал бы, и я захотел попробовать.
              </p>
              <p>
                Предложение хорошее, но подключение <strong>растянулось на 12 шагов</strong> с
                переходами в почту и браузер, подтверждением почты и несколькими согласиями, а в
                конце было непонятно, получилось ли.
              </p>
              <p>
                <strong>Трудности нашлись и в других действиях</strong>: счёт спрятан глубоко,
                история операций разбита по картам, для CVV нужен код из СМС даже после биометрии.
              </p>
              <p>
                По отдельности каждое из этих решений объяснимо, но вместе они{' '}
                <strong>делают простые действия сложнее, чем могли бы быть</strong>. Я решил
                разобраться, так ли это и можно ли сделать удобнее.
              </p>
            </div>
            <dl class="facts">
              <div>
                <dt>Роль</dt>
                <dd>Продуктовый дизайнер, в паре</dd>
              </div>
              <div>
                <dt>Формат</dt>
                <dd>Концепт, 2026</dd>
              </div>
              <div>
                <dt>Сфера</dt>
                <dd>Банк, B2C, мобильное приложение</dd>
              </div>
            </dl>
          </div>

          <div class="pair">
            <div class="tile px-clip">
              <span class="tile-icon px-clip">
                <PixelIcon name="alert" />
              </span>
              <h2 class="tile-title">Проблемы</h2>
              <ul class="list">
                <li>На главной продукты банка отвлекали от повседневных действий.</li>
                <li>
                  Связь карт и счёта не была обозначена, история операций была разбита по картам.
                </li>
                <li>
                  Данные карты лежали на третьей вкладке «О карте», CVV открывался только по коду из
                  СМС.
                </li>
                <li>
                  Кешбэк подключался через почту и браузер и после этого не открывался до обновления
                  экрана.
                </li>
              </ul>
            </div>
            <div class="tile px-clip">
              <span class="tile-icon px-clip">
                <PixelIcon name="spark" />
              </span>
              <h2 class="tile-title">Решения</h2>
              <ul class="list">
                <li>
                  Пересобрал иерархию главной вокруг баланса и повседневных действий, а предложения
                  банка оставил заметными, но их можно закрыть.
                </li>
                <li>Перенёс карты внутрь их счетов и добавил копирование данных карты.</li>
                <li>
                  Объединил подключение кешбэка с выбором категорий, чтобы он сразу заработал.
                </li>
              </ul>
            </div>
          </div>

          <div class="results">
            <h2 class="results-title">
              <span class="tile-icon px-clip">
                <PixelIcon name="trend" />
              </span>
              Результаты
            </h2>
            <ul class="stats">
              {stats.map((s) => (
                <li class="stat px-clip">
                  <span class="stat-value">
                    {s.from && (
                      <>
                        <span class="stat-from">{s.from}</span>
                        <span class="stat-arrow" aria-label="→">
                          <PixelIcon name="arrow" size={24} />
                        </span>
                      </>
                    )}
                    <span>{s.to}</span>
                    {s.unit && <span class="stat-unit">{s.unit}</span>}
                  </span>
                  <span class="stat-label">{s.label}</span>
                </li>
              ))}
            </ul>
            <p class="note">
              Юзабилити-тест с 30 клиентами банка: все дошли до конца каждой задачи.
            </p>
          </div>
        </section>

        <!-- ---------- Final screens ---------- -->
        <section id="screens" class="sheet px-clip">
          <p class="eyebrow">Итог</p>
          <h2 class="h2">Финальные экраны</h2>
          <div class="gallery" tabindex="0" aria-label="Финальные экраны, прокручиваются вбок">
            {screens.map((s) => (
              <figure class="shot">
                <Phone src={s.src} alt={s.caption} />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>

        <!-- ---------- Process ---------- -->
        <section id="process" class="sheet px-clip">
          <p class="eyebrow">Процесс</p>
          <h2 class="h2">Как мы работали</h2>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step">
                <div class="step-text">
                  <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="h3">{s.title}</h3>
                  <p class="body">{s.text}</p>
                </div>
                <div class="step-media">
                  {s.scene === 'team' ? (
                    <TeamScene />
                  ) : s.scene === 'bench' ? (
                    <BenchScene />
                  ) : s.scene === 'testing' ? (
                    <TestingScene />
                  ) : (
                    <div class="slot px-clip">
                      <Media label={{ ru: 'Видео прототипа', en: 'Prototype video' }} />
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- ---------- Interviews ---------- -->
        <section id="interviews" class="sheet px-clip">
          <p class="eyebrow">Исследование</p>
          <h2 class="h2">Что показали интервью</h2>
          <p class="lead">
            Когда масштаб был выбран, мы поговорили с тремя клиентами ПСБ, чтобы сопоставить свои
            предположения с их опытом.
          </p>
          <div class="wide">
            <CaseVideo
              src="assets/cases/psb/interviews.ru.mp4"
              poster="assets/cases/psb/interviews-poster.ru.webp"
              enSrc="assets/cases/psb/interviews.en.mp4"
              enPoster="assets/cases/psb/interviews-poster.en.webp"
              ratio="16 / 9"
              label="Фрагменты интервью"
              enLabel="Interview excerpts"
            />
          </div>
          <ol class="findings">
            {findings.map((f, i) => (
              <li>
                <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="finding-title">{f.title}</h3>
                <p class="body">{f.text}</p>
              </li>
            ))}
          </ol>
          <p class="quote px-clip">
            Одного сокращения пути было недостаточно. Нужно было сделать понятным весь процесс: где
            найти нужное, как выполнить действие и увидеть результат.
          </p>
        </section>

        <!-- ---------- Directions ---------- -->
        {directions.map((d, i) => (
          <section id={d.id} class="sheet px-clip">
            <p class="eyebrow">
              Решение {i + 1} из {directions.length}
            </p>
            <h2 class="h2">{d.title}</h2>
            <p class="lead">{d.lead}</p>
            <div class="stage px-clip">
              {d.compare ? (
                <>
                  <span class="stage-tag left px-clip">До</span>
                  <span class="stage-tag right px-clip">После</span>
                  <div class="stage-phone">
                    <Compare before={d.compare.before} after={d.compare.after} label={d.title} />
                  </div>
                </>
              ) : (
                <>
                  <span class="stage-tag left px-clip">После</span>
                  <div class="stage-phones">
                    {d.after?.map((src) => (
                      <div class="stage-phone">
                        <Phone src={src} alt={`${d.title}: новый экран`} />
                      </div>
                    ))}
                  </div>
                  <span class="stage-note">Экраны «до» добавим</span>
                </>
              )}
            </div>
            <div class="psr">
              <div>
                <h3 class="psr-title">Проблема</h3>
                <p class="body">{d.problem}</p>
              </div>
              <div>
                <h3 class="psr-title">Решение</h3>
                <p class="body">{d.solution}</p>
              </div>
              <div>
