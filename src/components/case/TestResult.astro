---
import { en, ru, type Localized, type Text } from '../../content/site';

export interface ResultStat {
  value: Text;
  unit?: Localized;
  note: Localized;
}

interface Props {
  stats: ResultStat[];
}

/**
 * The result of the test for one solution: a card of its own under the stage, not the end of
 * the list of changes (the owner: it's a different thing, what people did, not what we
 * changed). Kept light (owner: heavy with the trophy tile, a big heading and bold figures, and
 * the overview's bars and hearts didn't suit it): a quiet heading, the figures in medium weight.
 */
const { stats } = Astro.props;
---

<section class="test px-clip">
  <div class="head">
    <h3 class="title" data-en="Test result">
      Итог теста
    </h3>
    <span class="sub" data-en="Usability test with 30 of the bank’s customers">
      Юзабилити-тест с 30 клиентами банка
    </span>
  </div>
  <ul class="stats" style={`--n: ${stats.length}`}>
    {stats.map((st) => (
      <li class="stat">
        <span class="value">
          <span data-en={en(st.value)}>{ru(st.value)}</span>
          {st.unit && (
            <span class="unit" data-en={st.unit.en}>
              {st.unit.ru}
            </span>
          )}
        </span>
        <span class="note" data-en={st.note.en}>
          {st.note.ru}
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* A card of its own on the sheet, a frame's gap under the stage: the heading on top, the
     stats under it. The same raised paper and pixel corners as the overview's cards */
  .test {
    --px-step: 4px;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: var(--space-tile-gap);
    padding: var(--space-tile);
    background: var(--surface-raised);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text-primary);
  }
  .sub {
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--text-tertiary);
  }
  /* Columns well apart, more than anything inside a figure; a third goes under the first two
     on a narrow card */
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .value {
    font-size: var(--t-h3);
    font-weight: var(--fw-medium);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .unit {
    margin-left: 0.25em;
    font-size: var(--t-small);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  .note {
    font-size: var(--t-body-sm);
    line-height: var(--lh-normal);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  @container (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
      gap: 24px;
    }
  }
</style>
