          { src: 'assets/cases/psb/before/cats-05.webp', caption: 'Операция выполнена' },
        ],
      },
      {
        label: 'Стало',
        steps: 6,
        seconds: 14,
        end: 'готово',
        win: true,
        screens: [
          // Captured from the live prototype with cashback connected by tools/psb-race/capture.mjs
          { src: 'assets/cases/psb/race/next-home.webp', caption: 'Главная, вкладка «Выгода»' },
          { src: 'assets/cases/psb/race/next-cashback.webp', caption: '«Категории на октябрь»' },
          { src: 'assets/cases/psb/race/next-0.webp', caption: 'Выбор трёх категорий' },
          { src: 'assets/cases/psb/race/next-1.webp', caption: 'Отметил «Самокаты»', same: true },
          { src: 'assets/cases/psb/race/next-2.webp', caption: 'Отметил «Такси»', same: true },
          { src: 'assets/cases/psb/race/next-3.webp', caption: 'Отметил «Деливери»', same: true },
          { src: 'assets/cases/psb/race/next-success.webp', caption: 'Категории выбраны' },
        ],
      },
    ],
    versus: {
      rows: [
        {
          label: 'Где найти',
          before: '«Бонусный счёт» в конце главной',
          after: '«Выгода» в таббаре',
        },
        {
          label: 'Напоминание',
          before: 'Нет, о новом месяце нужно помнить самому',
          after: 'Плашка «Категории на октябрь» с кнопкой «Выбрать»',
        },
        {
          label: 'Когда выбирать',
          before: 'Каждый месяц, когда он уже начался',
          after: 'Заранее, и поменять до начала месяца',
        },
        {
          label: 'Подтверждение',
          before: 'Отдельный экран с юридическими формулировками',
          after: 'Кнопка «Подключить» под категориями',
        },
      ],
      stats: [
        {
          value: '100%',
          note: 'сразу начали с правильного действия: выбор как при первом подключении',
        },
        { value: '90%', note: 'прошли без ошибок' },
        { value: '6,7', unit: 'из 7', note: 'оценка лёгкости, самая высокая в тесте' },
      ],
    },
