---
import '../styles/global.css';
import { withBase } from '../scripts/url';

interface Props {
  title: string;
  description?: string;
  /** Link-preview image in /public (1200×630). */
  image?: string;
  /** Tab title for English readers. */
  enTitle?: string;
}

// Bump ?v= whenever og-cover.png changes: messengers cache link-preview images by URL.
const {
  title,
  description = 'Портфолио',
  image = 'assets/og-cover.png?v=2',
  enTitle,
} = Astro.props;
// Messengers need absolute URLs; `site` is set by the deploy workflow.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pageUrl = absolute(Astro.url.pathname);
const imageUrl = absolute(withBase(image));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E7E0D0" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Fira+Mono:wght@400;500&family=Handjet:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <!-- Russian is rendered into the HTML; any other first browser language gets English.
         Decided before the first paint, so blocks with data-lang never flash the wrong one.
         ?lang=en or ?lang=ru in the address overrides it. -->
    <script is:inline>
      (function () {
        var forced = /[?&]lang=(ru|en)\b/.exec(location.search);
        var nav = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
        if (forced ? forced[1] === 'en' : !/^ru/i.test(nav)) document.documentElement.lang = 'en';
      })();
    </script>
  </head>
  <body>
    <slot />
    <!-- English: data-en is the text, data-en-label / -alt / -title / -src / -poster the attributes, and
         any other data-en-x replaces data-x that a script reads (race captions, typed lines).
         Inline, so it runs before the page's module scripts read those attributes. -->
    <script is:inline define:vars={{ enTitle }}>
      if (document.documentElement.lang === 'en') {
        if (enTitle) document.title = enTitle;
        var attrs = {
          label: 'aria-label',
          alt: 'alt',
          title: 'title',
          src: 'src',
          poster: 'poster',
        };
        document.querySelectorAll('body *').forEach(function (el) {
          for (var i = 0; i < el.attributes.length; i++) {
            var a = el.attributes[i];
            if (a.name === 'data-en') el.textContent = a.value;
            else if (a.name.indexOf('data-en-') === 0) {
              var key = a.name.slice(8);
              el.setAttribute(attrs[key] || 'data-' + key, a.value);
            }
          }
        });
      }
    </script>
  </body>
</html>
